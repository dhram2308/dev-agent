      },
      "_ac_agent_result": "## AC Verification Results\n\nThe changes address three root causes of the \"original month displayed after action button delete\" bug:\n\n### Change Analysis\n\n**1. `ColumnInputText.tsx` — `defaultValue` → `value` (critical fix)**\n- Changed from uncontrolled (`defaultValue`) to controlled (`value`) input. With `defaultValue`, the Input component ignores prop updates after initial render, so when a row is deleted and remaining rows re-render with shifted data, the original month field still showed stale values.\n\n**2. `onDeleteClick` in all summary tables — sync data before filtering (critical fix)**\n- Previously: `tableData.filter(...)` — filtered from stale `tableData` that didn't include inline edits from `showOnlyData`\n- Now: `getSyncedData(tableData, showOnlyData).filter(...)` — merges edited values before filtering, so remaining rows retain their current edited values\n\n**3. `rowKey='id'` added to all `AppTable` instances (critical fix)**\n- Without `rowKey`, Ant Design uses array index as key. After deleting a row, index-based keys shift, causing React to mismatch DOM elements with data — the deleted row's \"original month\" value would appear on a remaining row.\n\n---\n\n### AC Evaluation\n\n**AC: B2CSA summary UI is incorrect, original month displayed after action button delete → PASS**\n\nAll three root causes are addressed:\n- Controlled input (`value`) ensures UI reflects current data after deletion\n- `getSyncedData` ensures inline edits are preserved when rows are removed\n- `rowKey='id'` ensures React correctly tracks row identity across deletions\n- Fix applied consistently to B2CSASummary and all 9 other similar summary tables (defensive fix)\n\n**OVERALL: PASS**",
      "_ac_verification": "## AC Verification Results\n\nThe changes address three root causes of the \"original month displayed after action button delete\" bug:\n\n### Change Analysis\n\n**1. `ColumnInputText.tsx` — `defaultValue` → `value` (critical fix)**\n- Changed from uncontrolled (`defaultValue`) to controlled (`value`) input. With `defaultValue`, the Input component ignores prop updates after initial render, so when a row is deleted and remaining rows re-render with shifted data, the original month field still showed stale values.\n\n**2. `onDeleteClick` in all summary tables — sync data before filtering (critical fix)**\n- Previously: `tableData.filter(...)` — filtered from stale `tableData` that didn't include inline edits from `showOnlyData`\n- Now: `getSyncedData(tableData, showOnlyData).filter(...)` — merges edited values before filtering, so remaining rows retain their current edited values\n\n**3. `rowKey='id'` added to all `AppTable` instances (critical fix)**\n- Without `rowKey`, Ant Design uses array index as key. After deleting a row, index-based keys shift, causing React to mismatch DOM elements with data — the deleted row's \"original month\" value would appear on a remaining row.\n\n---\n\n### AC Evaluation\n\n**AC: B2CSA summary UI is incorrect, original month displayed after action button delete → PASS**\n\nAll three root causes are addressed:\n- Controlled input (`value`) ensures UI reflects current data after deletion\n- `getSyncedData` ensures inline edits are preserved when rows are removed\n- `rowKey='id'` ensures React correctly tracks row identity across deletions\n- Fix applied consistently to B2CSASummary and all 9 other similar summary tables (defensive fix)\n\n**OVERALL: PASS**",
      "_ac_retry_count": 0,
      "_ac_verified": true,
      "_test_phase_complete": true,
      "original_files": {
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/AmendedSummary/index.tsx": "import React, { useEffect, useState } from 'react';\n\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport AppTable from '@mi/shared/AppTable';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  isGstr1A?: boolean;\n};\n\nconst AmendedSummary = ({ isGstr1A, isSez }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/adjustment-advance-amended-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      pos: '',\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n      original_month: '',\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => getGstr1DecimalData(row));\n\n    postDataApi(\n      'gst-returns/gstr1/voucher-summary/?isamended=y&invoice_type=performa&voucher_type=Refund Voucher',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        reCallAPI();\n        setEditEnabled(false);\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1TxpdaEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteClick = (id: number) => {\n    setData({ data: tableData.filter((item) => item.id !== id) });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/advance-amended-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n        // reCallAPI();\n        // onMPGSTR1TxpdaDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(\n      `gst-returns/gstr1/adjustment-advance-amended-summary/download/`,\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1TxpdaDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  return (\n    <TableContainer id='amended-summary'>\n      <TableHeader\n        heading='Amended Advance Received in Earlier Tax Period'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n\n      />\n\n      <AppTable\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick, isSez)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(AmendedSummary);\n",
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/AmendedSuppliesEcom/index.tsx": "import React, { useEffect, useState } from 'react';\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport type { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { GSTINRegx } from '@mi/constants/Regex';\nimport {\n  generateDataWithId,\n  getSupecoDecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\nexport const messagesMapping = {\n  etin: 'Please Enter Valid GSTIN',\n  oetin: 'Please Enter Original GSTIN',\n  omon: 'Please Enter Original Month in MM-YYYY format',\n  supeco: 'Please Select SUPECO Section',\n  supply_type: 'Please Select Supply Type',\n};\ntype Props = {\n  isGstr1A?: boolean;\n};\n\nconst AmendedSuppliesEcom = ({ isGstr1A }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/supeco-summary/?is_amended=Y',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: any, key = 'cgst') => {\n    const newValues = {\n      ...newRecord,\n      net_val:\n        newRecord.igst +\n        newRecord.cess +\n        newRecord.suppval +\n        (key === 'cgst' ? 2 * newRecord.cgst : 2 * newRecord.sgst),\n      cgst: key === 'cgst' ? newRecord.cgst : newRecord.sgst,\n      sgst: key === 'sgst' ? newRecord.sgst : newRecord.cgst,\n    };\n    setShowOnlyData((prevState) =>\n      Array.isArray(prevState)\n        ? prevState.map((item) => (item.id === newRecord.id ? newValues : item))\n        : newValues,\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: Array.isArray(tableData) ? tableData.length + 1 : 1,\n      igst: 0,\n      cgst: 0,\n      sgst: 0,\n      cess: 0,\n      suppval: 0,\n      net_val: 0,\n      supeco_section: '',\n      etin: '',\n      omon: '',\n      oetin: '',\n    };\n\n    setTableData((prevState) =>\n      Array.isArray(prevState) ? [...prevState, newRow] : [newRow],\n    );\n    setShowOnlyData((prevState) =>\n      Array.isArray(prevState) ? [...prevState, newRow] : [newRow],\n    );\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    let key = '';\n    let finalTableData: Gstr1SummaryTableProps[] = [];\n    const allData = getSyncedData(tableData, showOnlyData);\n    for (const item of allData) {\n      if (!(item.oetin && GSTINRegx.test(item.oetin))) {\n        key = 'oetin';\n        break;\n      } else if (!(item.omon && item.omon.length === 7)) {\n        key = 'omon';\n        break;\n      } else if (item?.supeco_section === '') {\n        key = 'supeco';\n        break;\n      } else if (!(item.etin && GSTINRegx.test(item.etin))) {\n        key = 'etin';\n        break;\n      }\n      finalTableData = finalTableData.concat({\n        ...getSupecoDecimalData(item),\n        omon: item.omon ? item.omon.replace('-', '') : '',\n      });\n    }\n\n    if (key === '')\n      postDataApi('gst-returns/gstr1/supeco-summary/', infoViewContext, {\n        data: finalTableData,\n        is_amended: 'Y',\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      })\n        .then((response) => {\n          infoViewContext.showMessage(response.message);\n          reCallAPI();\n          setEditEnabled(false);\n          // onMPGSTR1TxpdEdit(response);\n        })\n        .catch((error) => {\n          infoViewContext.fetchError(error.message);\n        });\n    else {\n      infoViewContext.fetchError(\n        messagesMapping[key as keyof typeof messagesMapping],\n      );\n    }\n  };\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n  const onDeleteClick = (id: number) => {\n    setData({\n      data: tableData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi(\n      'gst-returns/gstr1/supeco-summary/?is_amended=Y',\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n        // reCallAPI();\n        // onMPGSTR1TxpdDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(\n      `gst-returns/gstr1/supeco-summary/download/?is_amended=Y`,\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1TxpdDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  return (\n    <TableContainer id='amended-supplies-ecom'>\n      <TableHeader\n        heading='Amended Supplies made through the E-Commerce Operators'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n      />\n\n      <AppTable\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(AmendedSuppliesEcom);\n",
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/B2CSASummary/index.tsx": "import { ThemeMode } from '@mi/constants/AppEnums';\nimport { useAppContext } from '@mi/context/AppContextProvider';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { appDarkTable, appTable } from '@mi/db/global/theme';\nimport { getDoubleDigits } from '@mi/helpers/DateHelper';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { useCurrentBusiness } from '@mi/hooks/AuthHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { Alert } from 'antd';\nimport React, { useEffect, useMemo, useState } from 'react';\nimport { StyledContainer } from '../index.styled';\nimport TableHeader from '../TableHeader';\nimport { TableContainer } from '../Tables.styles';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { getColumns } from './columns';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  isGstr1A?: boolean;\n  warningMessage?: boolean;\n};\n\nconst B2CSASummary = ({ isGstr1A, isSez, warningMessage = false }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const currentBusiness = useCurrentBusiness();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const { themeMode } = useAppContext();\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/b2csa-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  const stateCode = useMemo(() => {\n    if (currentBusiness?.active_gstin) {\n      const codeOfState = +currentBusiness?.active_gstin?.substr(0, 2);\n      return getDoubleDigits(codeOfState);\n    }\n  }, [currentBusiness?.active_gstin]);\n\n  const style =\n    themeMode === ThemeMode.DARK\n      ? {\n          background: appDarkTable.headerBgColor,\n          color: appDarkTable.textColor,\n          border: `1px solid ${appDarkTable.borderColor}`,\n        }\n      : {\n          background: appTable.headerBgColor,\n          color: appTable.textColor,\n          border: `1px solid ${appTable.borderColor}`,\n        };\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      sub_type: '',\n      pos: '',\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n      etin: '',\n      original_month: '',\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => {\n      if (row.sub_type === 'intra') {\n        row.pos = stateCode as string;\n      }\n\n      if (!row.etin) {\n        row.etin = 'N';\n      }\n\n      return getGstr1DecimalData(row);\n    });\n\n    postDataApi(\n      'gst-returns/gstr1/b2cs-summary/?invoice_type=b2csa',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        infoViewContext.showMessage(response.message);\n        reCallAPI();\n        setEditEnabled(false);\n        // onMPGSTR1B2csaEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteClick = (id: number) => {\n    setData({\n      data: tableData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/b2csa-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n        // reCallAPI();\n        // onMPGSTR1B2csaDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/b2csa-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1B2csaDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  const isDataPresent = loading || Array.isArray(apiData?.data);\n\n  return (\n    <TableContainer id='b2sca-summary'>\n      <TableHeader\n        heading='B2CSA Summary'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isDatainProgress={!isDataPresent}\n        isGSTR1A={isGstr1A || false}\n      />\n      {warningMessage && (\n        <Alert\n          message={\n            'For more than 10,000 invoices, please regenerate B2CSA Summary to view latest summary!'\n          }\n          type={'warning'}\n          showIcon\n          style={{ marginBottom: 20, width: 'fit-content', paddingRight: 20 }}\n        />\n      )}\n      {isDataPresent ? (\n        <AppTable\n          loading={loading}\n          dataSource={showOnlyData}\n          onChange={handleTableChange}\n          columns={getColumns(\n            isEditEnabled,\n            onValueChange,\n            onDeleteClick,\n            stateCode!,\n            isSez,\n          )}\n          pagination={false}\n        />\n      ) : (\n        <StyledContainer style={style}>\n          <span style={{ fontSize: 16 }}>{apiData.message}</span>\n        </StyledContainer>\n      )}\n    </TableContainer>\n  );\n};\n\nexport default React.memo(B2CSASummary);\n",
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/B2CSSummary/index.tsx": "import React, { useEffect, useMemo, useState } from 'react';\n\nimport { ThemeMode } from '@mi/constants/AppEnums';\nimport { useAppContext } from '@mi/context/AppContextProvider';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { appDarkTable, appTable } from '@mi/db/global/theme';\nimport { getDoubleDigits } from '@mi/helpers/DateHelper';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { useCurrentBusiness } from '@mi/hooks/AuthHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { Alert } from 'antd';\nimport { StyledContainer } from '../index.styled';\nimport TableHeader from '../TableHeader';\nimport { TableContainer } from '../Tables.styles';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { getColumns } from './columns';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  warningMessage?: boolean;\n  isGstr1A?: boolean;\n};\n\nconst B2CSSummary = ({\n  isGstr1A = false,\n  isSez = false,\n  warningMessage = false,\n}: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const currentBusiness = useCurrentBusiness();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const { themeMode } = useAppContext();\n\n  const stateCode = useMemo(() => {\n    if (currentBusiness?.active_gstin) {\n      const codeOfState = +currentBusiness?.active_gstin?.substr(0, 2);\n      return getDoubleDigits(codeOfState);\n    }\n  }, [currentBusiness?.active_gstin]);\n\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/b2cs-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n  const style =\n    themeMode === ThemeMode.DARK\n      ? {\n          background: appDarkTable.headerBgColor,\n          color: appDarkTable.textColor,\n          border: `1px solid ${appDarkTable.borderColor}`,\n        }\n      : {\n          background: appTable.headerBgColor,\n          color: appTable.textColor,\n          border: `1px solid ${appTable.borderColor}`,\n        };\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      sub_type: '',\n      pos: '',\n      rt: '0',\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n      etin: '',\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => {\n      if (row.sub_type === 'intra') {\n        row.pos = stateCode as string;\n      }\n\n      if (!row.etin) {\n        row.etin = 'N';\n      }\n\n      return getGstr1DecimalData(row);\n    });\n\n    postDataApi(\n      'gst-returns/gstr1/b2cs-summary/?invoice_type=b2cs',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        infoViewContext.showMessage(response.message);\n        reCallAPI();\n        setEditEnabled(false);\n        // onMPGSTR1B2csEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteClick = (id: number) => {\n    setData({\n      data: tableData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/b2cs-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/b2cs-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1B2csDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n  const isDataPresent = loading || Array.isArray(apiData?.data);\n\n  return (\n    <TableContainer id='b2sc-summary'>\n      <TableHeader\n        heading='B2CS Summary'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isDatainProgress={!isDataPresent}\n        isGSTR1A={isGstr1A || false}\n      />\n      {warningMessage && (\n        <Alert\n          message={\n            'For more than 10,000 invoices, please regenerate B2CS Summary to view latest summary!'\n          }\n          type={'warning'}\n          showIcon\n          style={{ marginBottom: 20, width: 'fit-content', paddingRight: 20 }}\n        />\n      )}\n      {isDataPresent ? (\n        <AppTable\n          loading={loading}\n          dataSource={showOnlyData}\n          onChange={handleTableChange}\n          columns={getColumns(\n            isEditEnabled,\n            onValueChange,\n            onDeleteClick,\n            stateCode,\n            isSez,\n          )}\n          pagination={false}\n        />\n      ) : (\n        <StyledContainer style={style}>\n          <span style={{ fontSize: 16 }}>{apiData.message}</span>\n        </StyledContainer>\n      )}\n    </TableContainer>\n  );\n};\n\nexport default React.memo(B2CSSummary);\n",
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/DocumentSummary/index.tsx": "import { ThemeMode } from '@mi/constants/AppEnums';\nimport { useAppContext } from '@mi/context/AppContextProvider';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { appDarkTable, appTable } from '@mi/db/global/theme';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { Alert } from 'antd';\nimport React, { useEffect, useState } from 'react';\nimport { StyledContainer } from '../index.styled';\nimport TableHeader from '../TableHeader';\nimport { TableContainer } from '../Tables.styles';\nimport { getColumns } from './columns';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\nimport { generateDataWithId, getSyncedData } from '../utils';\n\ntype Props = {\n  isGstr1A?: boolean;\n  warningMessage?: boolean;\n};\n\nconst DocumentSummary = ({ isGstr1A, warningMessage }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const { themeMode } = useAppContext();\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/document-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps) => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) => (item.id === newRecord.id ? newRecord : item)),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      document_type: undefined,\n      from: 0,\n      to: 0,\n      totnum: 0,\n      cancel: 0,\n      net_issue: 0,\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onDeleteClick = (id: number) => {\n    setData({ data: tableData.filter((item) => item.id !== id) });\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    postDataApi('gst-returns/gstr1/document-summary/', infoViewContext, {\n      data: allData,\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        infoViewContext.showMessage(response.message);\n        reCallAPI();\n        setEditEnabled(false);\n        // onMPGSTR1DocSummaryEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/doc-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n        // onMPGSTR1DocSummaryDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/doc-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1DocSummaryDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n  const style =\n    themeMode === ThemeMode.DARK\n      ? {\n          background: appDarkTable.headerBgColor,\n          color: appDarkTable.textColor,\n          border: `1px solid ${appDarkTable.borderColor}`,\n        }\n      : {\n          background: appTable.headerBgColor,\n          color: appTable.textColor,\n          border: `1px solid ${appTable.borderColor}`,\n        };\n  const isDataPresent = loading || Array.isArray(apiData?.data);\n\n  return (\n    <TableContainer id='document-summary'>\n      <TableHeader\n        heading='Document Summary'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isDatainProgress={!isDataPresent}\n        isGSTR1A={isGstr1A || false}\n      />\n      {warningMessage && (\n        <Alert\n          message={\n            'For more than 10,000 invoices, please regenerate Document Summary to view latest summary!'\n          }\n          type={'warning'}\n          showIcon\n          style={{ marginBottom: 20, width: 'fit-content', paddingRight: 20 }}\n        />\n      )}\n      {isDataPresent ? (\n        <AppTable\n          loading={loading}\n          dataSource={showOnlyData}\n          onChange={handleTableChange}\n          columns={getColumns(isEditEnabled, onValueChange, onDeleteClick)}\n          pagination={false}\n        />\n      ) : (\n        <StyledContainer style={style}>\n          <span style={{ fontSize: 16 }}>{apiData.message}</span>\n        </StyledContainer>\n      )}\n    </TableContainer>\n  );\n};\n\nexport default React.memo(DocumentSummary);\n",
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/HSNSummary/index.tsx": "import { ThemeMode } from '@mi/constants/AppEnums';\nimport { useAppContext } from '@mi/context/AppContextProvider';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { appDarkTable, appTable } from '@mi/db/global/theme';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport {\n  Gstr1InputIdKeys,\n  Gstr1SummaryTableProps,\n} from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { Alert } from 'antd';\nimport React, { useEffect, useState } from 'react';\nimport { StyledContainer } from '../index.styled';\nimport TableHeader from '../TableHeader';\nimport { TableContainer } from '../Tables.styles';\nimport { getColumns } from './columns';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\nimport { generateDataWithId, getSyncedData } from '../utils';\n\ntype Props = {\n  isGstr1A?: boolean;\n  warningMessage?: boolean;\n};\n\nconst HSNSummary = ({ isGstr1A, warningMessage = false}: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/hsn-summary/',\n    undefined,\n    {\n      ...(isGstr1A ? { data_type: 'GSTR1A' } : {})}\n  );\n  const { themeMode } = useAppContext();\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      hsn_sc: '',\n      item_name: '',\n      uqc: '',\n      qty: 0,\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onDeleteClick = (id: number) => {\n    setData({ data: tableData.filter((item) => item.id !== id) });\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const updatedTableData = allData.map((item) => {\n      // for (const key as Gstr1InputIdKeys in item) {\n      for (const key in item) {\n        if (item[key as Gstr1InputIdKeys] === null) {\n          item = { ...item, [key as Gstr1InputIdKeys]: '' };\n        }\n      }\n      return item;\n    });\n    postDataApi('gst-returns/gstr1/hsn-summary/', infoViewContext, {\n      data: updatedTableData,\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        reCallAPI();\n        setEditEnabled(false);\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1HSNEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/hsn-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1HSNDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/hsn-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1HSNDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  const style =\n    themeMode === ThemeMode.DARK\n      ? {\n          background: appDarkTable.headerBgColor,\n          color: appDarkTable.textColor,\n          border: `1px solid ${appDarkTable.borderColor}`,\n        }\n      : {\n          background: appTable.headerBgColor,\n          color: appTable.textColor,\n          border: `1px solid ${appTable.borderColor}`,\n        };\n  const isDataPresent = loading || Array.isArray(apiData?.data);\n  return (\n    <TableContainer id='hsn-summary'>\n      <TableHeader\n        heading={`HSN Summary`}\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isDatainProgress={!isDataPresent}\n        isGSTR1A={isGstr1A || false}\n      />\n\n      {warningMessage && (\n        <Alert\n          message={\n            'For more than 10,000 invoices, please regenerate HSN Summary to view latest summary!'\n          }\n          type={'warning'}\n          showIcon\n          style={{ marginBottom: 20, width: 'fit-content', paddingRight: 20 }}\n        />\n      )}\n      {isDataPresent ? (\n        <AppTable\n          loading={loading}\n          dataSource={showOnlyData}\n          onChange={handleTableChange}\n          columns={getColumns(isEditEnabled, onValueChange, onDeleteClick)}\n          pagination={false}\n        />\n      ) : (\n        <StyledContainer style={style}>\n          <span style={{ fontSize: 16 }}>{apiData.message}</span>\n        </StyledContainer>\n      )}\n    </TableContainer>\n  );\n};\n\nexport default React.memo(HSNSummary);\n",
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/SuppliesEcom/index.tsx": "import React, { useEffect, useState } from 'react';\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport type { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { GSTINRegx } from '@mi/constants/Regex';\nimport { messagesMapping } from '../AmendedSuppliesEcom';\nimport {\n  generateDataWithId,\n  getSupecoDecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isGstr1A?: boolean;\n};\n\nconst SuppliesEcom = ({ isGstr1A}: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/supeco-summary/?is_amended=N',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: any, key = 'cgst') => {\n    const newValues = {\n      ...newRecord,\n      net_val:\n        newRecord.igst +\n        newRecord.cess +\n        newRecord.suppval +\n        (key === 'cgst' ? 2 * newRecord.cgst : 2 * newRecord.sgst),\n      cgst: key === 'cgst' ? newRecord.cgst : newRecord.sgst,\n      sgst: key === 'sgst' ? newRecord.sgst : newRecord.cgst,\n    };\n    setShowOnlyData((prevState) =>\n      Array.isArray(prevState)\n        ? prevState.map((item) => (item.id === newRecord.id ? newValues : item))\n        : newValues,\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: Array.isArray(tableData) ? tableData.length + 1 : 1,\n      igst: 0,\n      cgst: 0,\n      sgst: 0,\n      cess: 0,\n      suppval: 0,\n      net_val: 0,\n      supeco_section: '',\n      etin: '',\n    };\n\n    setTableData((prevState) =>\n      Array.isArray(prevState) ? [...prevState, newRow] : [newRow],\n    );\n    setShowOnlyData((prevState) =>\n      Array.isArray(prevState) ? [...prevState, newRow] : [newRow],\n    );\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    let key = '';\n    let finalTableData: Gstr1SummaryTableProps[] = [];\n    const allData = getSyncedData(tableData, showOnlyData);\n    for (const item of allData) {\n      if (item?.supeco_section === '') {\n        key = 'supeco';\n        break;\n      } else if (!(item.etin && GSTINRegx.test(item.etin))) {\n        key = 'etin';\n        break;\n      }\n\n      finalTableData = finalTableData.concat({\n        ...getSupecoDecimalData(item),\n        omon: item.omon ? item.omon.replace('-', '') : '',\n      });\n    }\n\n    if (key === '')\n      postDataApi('gst-returns/gstr1/supeco-summary/', infoViewContext, {\n        data: finalTableData,\n        is_amended: 'N',\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      })\n        .then((response) => {\n          infoViewContext.showMessage(response.message);\n          reCallAPI();\n          setEditEnabled(false);\n          // onMPGSTR1TxpdEdit(response);\n        })\n        .catch((error) => {\n          infoViewContext.fetchError(error.message);\n        });\n    else {\n      infoViewContext.fetchError(\n        messagesMapping[key as keyof typeof messagesMapping],\n      );\n    }\n  };\n\n  const onDeleteClick = (id: number) => {\n    setData({\n      data: tableData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi(\n      'gst-returns/gstr1/supeco-summary/?is_amended=N',\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n\n        // reCallAPI();\n        // onMPGSTR1TxpdDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(\n      `gst-returns/gstr1/supeco-summary/download/?is_amended=N`,\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1TxpdDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  return (\n    <TableContainer id='supplies-ecom'>\n      <TableHeader\n        heading='Supplies made through the E-Commerce Operators'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n\n      />\n\n      <AppTable\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(SuppliesEcom);\n",
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/VoucherAmendedSummary/index.tsx": "import React, { useEffect, useState } from 'react';\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\n// import { onMPGSTR1AdvaEdit } from '@mi/services/mixpanel';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport AppTable from '@mi/shared/AppTable';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  isGstr1A?: boolean;\n};\n\nconst VoucherAmendedSummary = ({ isGstr1A, isSez }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/voucher-amended-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (apiData?.data) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      pos: '',\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n      original_month: '',\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => getGstr1DecimalData(row));\n\n    postDataApi(\n      'gst-returns/gstr1/voucher-summary/?isamended=y&invoice_type=performa&voucher_type=Receipt Voucher',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        reCallAPI();\n        setEditEnabled(false);\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1AdvaEdit(response.message);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteClick = (id: number) => {\n    setData({\n      data: tableData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/vcha-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n        // reCallAPI();\n        // onMPGSTR1AdvaDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(\n      `gst-returns/gstr1/voucher-amended-summary/download/`,\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        if (response.success) {\n          if (response.download_url) {\n            const fileName = getFileName(response.download_url);\n            downloadFileData(fileName, infoViewContext, {\n              url: response.download_url,\n            });\n          }\n          // onMPGSTR1AdvaDownload(response);\n        } else {\n          infoViewContext.fetchError(response.message);\n        }\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n  return (\n    <TableContainer id='voucherAmen-summary'>\n      <TableHeader\n        heading='Amended Advance Received in Current Tax Period'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n      />\n\n      <AppTable\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick, isSez)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(VoucherAmendedSummary);\n",
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/VoucherSummary/index.tsx": "import React, { useEffect, useState } from 'react';\n\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport AppTable from '@mi/shared/AppTable';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  isGstr1A?: boolean;\n};\n\nconst VoucherSummary = ({ isGstr1A, isSez }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/voucher-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (apiData?.data) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      pos: '',\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onDeleteClick = (id: number) => {\n    setData({\n      data: tableData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => getGstr1DecimalData(row));\n\n    postDataApi(\n      'gst-returns/gstr1/voucher-summary/?isamended=n&invoice_type=performa&voucher_type=Receipt Voucher',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        reCallAPI();\n        setEditEnabled(false);\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1AdvEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/vch-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n        // reCallAPI();\n        // onMPGSTR1AdvDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/voucher-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1AdvDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n  return (\n    <TableContainer id='voucher-summary'>\n      <TableHeader\n        heading='Advance Received in Current Tax Period'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n      />\n\n      <AppTable\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick, isSez)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(VoucherSummary);\n",
        "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/components/ColumnInputText.tsx": "import React from 'react';\nimport { Input } from 'antd';\nimport type { ColumnInputTextProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\n\nconst ColumnInputText = <T,>({\n  inputId,\n  record,\n  onChange,\n  rules,\n  ...restProps\n}: ColumnInputTextProps<T>) => {\n  return (\n    // TODO: Fix this\n    <Input\n      defaultValue={record[inputId as keyof T] as string}\n      onChange={(e) => {\n        if (onChange)\n          onChange({ ...record, [inputId as keyof T]: e.target.value || null });\n      }}\n      {...restProps}\n    />\n  );\n};\n\nexport const ColumnInputTextEdit = <T extends { [key: string]: any }>({\n  inputId,\n  record,\n  onChange,\n  ...restProps\n}: ColumnInputTextProps<T>) => {\n  return (\n    // TODO: Fix this\n    <Input\n      onChange={(e) => {\n        if (onChange)\n          onChange({\n            ...record,\n            itm_det: {\n              ...record.itm_det,\n              [inputId as string]: e.target.value || 0,\n            },\n          });\n      }}\n      {...restProps}\n    />\n  );\n};\n\nexport default ColumnInputText;\n"
      },
      "codeChanges": {
        "changes": [
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/AmendedSummary/index.tsx",
            "content": "import React, { useEffect, useState } from 'react';\n\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport AppTable from '@mi/shared/AppTable';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  isGstr1A?: boolean;\n};\n\nconst AmendedSummary = ({ isGstr1A, isSez }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/adjustment-advance-amended-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      pos: '',\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n      original_month: '',\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => getGstr1DecimalData(row));\n\n    postDataApi(\n      'gst-returns/gstr1/voucher-summary/?isamended=y&invoice_type=performa&voucher_type=Refund Voucher',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        reCallAPI();\n        setEditEnabled(false);\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1TxpdaEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteClick = (id: number) => {\n    const syncedData = getSyncedData(tableData, showOnlyData);\n    setData({ data: syncedData.filter((item) => item.id !== id) });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/advance-amended-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n        // reCallAPI();\n        // onMPGSTR1TxpdaDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(\n      `gst-returns/gstr1/adjustment-advance-amended-summary/download/`,\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1TxpdaDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  return (\n    <TableContainer id='amended-summary'>\n      <TableHeader\n        heading='Amended Advance Received in Earlier Tax Period'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n\n      />\n\n      <AppTable\n        rowKey='id'\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick, isSez)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(AmendedSummary);\n"
          },
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/AmendedSuppliesEcom/index.tsx",
            "content": "import React, { useEffect, useState } from 'react';\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport type { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { GSTINRegx } from '@mi/constants/Regex';\nimport {\n  generateDataWithId,\n  getSupecoDecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\nexport const messagesMapping = {\n  etin: 'Please Enter Valid GSTIN',\n  oetin: 'Please Enter Original GSTIN',\n  omon: 'Please Enter Original Month in MM-YYYY format',\n  supeco: 'Please Select SUPECO Section',\n  supply_type: 'Please Select Supply Type',\n};\ntype Props = {\n  isGstr1A?: boolean;\n};\n\nconst AmendedSuppliesEcom = ({ isGstr1A }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/supeco-summary/?is_amended=Y',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: any, key = 'cgst') => {\n    const newValues = {\n      ...newRecord,\n      net_val:\n        newRecord.igst +\n        newRecord.cess +\n        newRecord.suppval +\n        (key === 'cgst' ? 2 * newRecord.cgst : 2 * newRecord.sgst),\n      cgst: key === 'cgst' ? newRecord.cgst : newRecord.sgst,\n      sgst: key === 'sgst' ? newRecord.sgst : newRecord.cgst,\n    };\n    setShowOnlyData((prevState) =>\n      Array.isArray(prevState)\n        ? prevState.map((item) => (item.id === newRecord.id ? newValues : item))\n        : newValues,\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: Array.isArray(tableData) ? tableData.length + 1 : 1,\n      igst: 0,\n      cgst: 0,\n      sgst: 0,\n      cess: 0,\n      suppval: 0,\n      net_val: 0,\n      supeco_section: '',\n      etin: '',\n      omon: '',\n      oetin: '',\n    };\n\n    setTableData((prevState) =>\n      Array.isArray(prevState) ? [...prevState, newRow] : [newRow],\n    );\n    setShowOnlyData((prevState) =>\n      Array.isArray(prevState) ? [...prevState, newRow] : [newRow],\n    );\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    let key = '';\n    let finalTableData: Gstr1SummaryTableProps[] = [];\n    const allData = getSyncedData(tableData, showOnlyData);\n    for (const item of allData) {\n      if (!(item.oetin && GSTINRegx.test(item.oetin))) {\n        key = 'oetin';\n        break;\n      } else if (!(item.omon && item.omon.length === 7)) {\n        key = 'omon';\n        break;\n      } else if (item?.supeco_section === '') {\n        key = 'supeco';\n        break;\n      } else if (!(item.etin && GSTINRegx.test(item.etin))) {\n        key = 'etin';\n        break;\n      }\n      finalTableData = finalTableData.concat({\n        ...getSupecoDecimalData(item),\n        omon: item.omon ? item.omon.replace('-', '') : '',\n      });\n    }\n\n    if (key === '')\n      postDataApi('gst-returns/gstr1/supeco-summary/', infoViewContext, {\n        data: finalTableData,\n        is_amended: 'Y',\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      })\n        .then((response) => {\n          infoViewContext.showMessage(response.message);\n          reCallAPI();\n          setEditEnabled(false);\n          // onMPGSTR1TxpdEdit(response);\n        })\n        .catch((error) => {\n          infoViewContext.fetchError(error.message);\n        });\n    else {\n      infoViewContext.fetchError(\n        messagesMapping[key as keyof typeof messagesMapping],\n      );\n    }\n  };\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n  const onDeleteClick = (id: number) => {\n    const syncedData = getSyncedData(tableData, showOnlyData);\n    setData({\n      data: syncedData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi(\n      'gst-returns/gstr1/supeco-summary/?is_amended=Y',\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n        // reCallAPI();\n        // onMPGSTR1TxpdDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(\n      `gst-returns/gstr1/supeco-summary/download/?is_amended=Y`,\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1TxpdDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  return (\n    <TableContainer id='amended-supplies-ecom'>\n      <TableHeader\n        heading='Amended Supplies made through the E-Commerce Operators'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n      />\n\n      <AppTable\n        rowKey='id'\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(AmendedSuppliesEcom);\n"
          },
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/B2CSASummary/index.tsx",
            "content": "import { ThemeMode } from '@mi/constants/AppEnums';\nimport { useAppContext } from '@mi/context/AppContextProvider';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { appDarkTable, appTable } from '@mi/db/global/theme';\nimport { getDoubleDigits } from '@mi/helpers/DateHelper';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { useCurrentBusiness } from '@mi/hooks/AuthHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { Alert } from 'antd';\nimport React, { useEffect, useMemo, useState } from 'react';\nimport { StyledContainer } from '../index.styled';\nimport TableHeader from '../TableHeader';\nimport { TableContainer } from '../Tables.styles';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { getColumns } from './columns';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  isGstr1A?: boolean;\n  warningMessage?: boolean;\n};\n\nconst B2CSASummary = ({ isGstr1A, isSez, warningMessage = false }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const currentBusiness = useCurrentBusiness();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const { themeMode } = useAppContext();\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/b2csa-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  const stateCode = useMemo(() => {\n    if (currentBusiness?.active_gstin) {\n      const codeOfState = +currentBusiness?.active_gstin?.substr(0, 2);\n      return getDoubleDigits(codeOfState);\n    }\n  }, [currentBusiness?.active_gstin]);\n\n  const style =\n    themeMode === ThemeMode.DARK\n      ? {\n          background: appDarkTable.headerBgColor,\n          color: appDarkTable.textColor,\n          border: `1px solid ${appDarkTable.borderColor}`,\n        }\n      : {\n          background: appTable.headerBgColor,\n          color: appTable.textColor,\n          border: `1px solid ${appTable.borderColor}`,\n        };\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      sub_type: '',\n      pos: '',\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n      etin: '',\n      original_month: '',\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => {\n      if (row.sub_type === 'intra') {\n        row.pos = stateCode as string;\n      }\n\n      if (!row.etin) {\n        row.etin = 'N';\n      }\n\n      return getGstr1DecimalData(row);\n    });\n\n    postDataApi(\n      'gst-returns/gstr1/b2cs-summary/?invoice_type=b2csa',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        infoViewContext.showMessage(response.message);\n        reCallAPI();\n        setEditEnabled(false);\n        // onMPGSTR1B2csaEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteClick = (id: number) => {\n    const syncedData = getSyncedData(tableData, showOnlyData);\n    setData({\n      data: syncedData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/b2csa-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n        // reCallAPI();\n        // onMPGSTR1B2csaDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/b2csa-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1B2csaDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  const isDataPresent = loading || Array.isArray(apiData?.data);\n\n  return (\n    <TableContainer id='b2sca-summary'>\n      <TableHeader\n        heading='B2CSA Summary'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isDatainProgress={!isDataPresent}\n        isGSTR1A={isGstr1A || false}\n      />\n      {warningMessage && (\n        <Alert\n          message={\n            'For more than 10,000 invoices, please regenerate B2CSA Summary to view latest summary!'\n          }\n          type={'warning'}\n          showIcon\n          style={{ marginBottom: 20, width: 'fit-content', paddingRight: 20 }}\n        />\n      )}\n      {isDataPresent ? (\n        <AppTable\n          rowKey='id'\n          loading={loading}\n          dataSource={showOnlyData}\n          onChange={handleTableChange}\n          columns={getColumns(\n            isEditEnabled,\n            onValueChange,\n            onDeleteClick,\n            stateCode!,\n            isSez,\n          )}\n          pagination={false}\n        />\n      ) : (\n        <StyledContainer style={style}>\n          <span style={{ fontSize: 16 }}>{apiData.message}</span>\n        </StyledContainer>\n      )}\n    </TableContainer>\n  );\n};\n\nexport default React.memo(B2CSASummary);\n"
          },
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/B2CSSummary/index.tsx",
            "content": "import React, { useEffect, useMemo, useState } from 'react';\n\nimport { ThemeMode } from '@mi/constants/AppEnums';\nimport { useAppContext } from '@mi/context/AppContextProvider';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { appDarkTable, appTable } from '@mi/db/global/theme';\nimport { getDoubleDigits } from '@mi/helpers/DateHelper';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { useCurrentBusiness } from '@mi/hooks/AuthHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { Alert } from 'antd';\nimport { StyledContainer } from '../index.styled';\nimport TableHeader from '../TableHeader';\nimport { TableContainer } from '../Tables.styles';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { getColumns } from './columns';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  warningMessage?: boolean;\n  isGstr1A?: boolean;\n};\n\nconst B2CSSummary = ({\n  isGstr1A = false,\n  isSez = false,\n  warningMessage = false,\n}: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const currentBusiness = useCurrentBusiness();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const { themeMode } = useAppContext();\n\n  const stateCode = useMemo(() => {\n    if (currentBusiness?.active_gstin) {\n      const codeOfState = +currentBusiness?.active_gstin?.substr(0, 2);\n      return getDoubleDigits(codeOfState);\n    }\n  }, [currentBusiness?.active_gstin]);\n\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/b2cs-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n  const style =\n    themeMode === ThemeMode.DARK\n      ? {\n          background: appDarkTable.headerBgColor,\n          color: appDarkTable.textColor,\n          border: `1px solid ${appDarkTable.borderColor}`,\n        }\n      : {\n          background: appTable.headerBgColor,\n          color: appTable.textColor,\n          border: `1px solid ${appTable.borderColor}`,\n        };\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      sub_type: '',\n      pos: '',\n      rt: '0',\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n      etin: '',\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => {\n      if (row.sub_type === 'intra') {\n        row.pos = stateCode as string;\n      }\n\n      if (!row.etin) {\n        row.etin = 'N';\n      }\n\n      return getGstr1DecimalData(row);\n    });\n\n    postDataApi(\n      'gst-returns/gstr1/b2cs-summary/?invoice_type=b2cs',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        infoViewContext.showMessage(response.message);\n        reCallAPI();\n        setEditEnabled(false);\n        // onMPGSTR1B2csEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteClick = (id: number) => {\n    const syncedData = getSyncedData(tableData, showOnlyData);\n    setData({\n      data: syncedData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/b2cs-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/b2cs-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1B2csDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n  const isDataPresent = loading || Array.isArray(apiData?.data);\n\n  return (\n    <TableContainer id='b2sc-summary'>\n      <TableHeader\n        heading='B2CS Summary'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isDatainProgress={!isDataPresent}\n        isGSTR1A={isGstr1A || false}\n      />\n      {warningMessage && (\n        <Alert\n          message={\n            'For more than 10,000 invoices, please regenerate B2CS Summary to view latest summary!'\n          }\n          type={'warning'}\n          showIcon\n          style={{ marginBottom: 20, width: 'fit-content', paddingRight: 20 }}\n        />\n      )}\n      {isDataPresent ? (\n        <AppTable\n          rowKey='id'\n          loading={loading}\n          dataSource={showOnlyData}\n          onChange={handleTableChange}\n          columns={getColumns(\n            isEditEnabled,\n            onValueChange,\n            onDeleteClick,\n            stateCode,\n            isSez,\n          )}\n          pagination={false}\n        />\n      ) : (\n        <StyledContainer style={style}>\n          <span style={{ fontSize: 16 }}>{apiData.message}</span>\n        </StyledContainer>\n      )}\n    </TableContainer>\n  );\n};\n\nexport default React.memo(B2CSSummary);\n"
          },
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/DocumentSummary/index.tsx",
            "content": "import { ThemeMode } from '@mi/constants/AppEnums';\nimport { useAppContext } from '@mi/context/AppContextProvider';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { appDarkTable, appTable } from '@mi/db/global/theme';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { Alert } from 'antd';\nimport React, { useEffect, useState } from 'react';\nimport { StyledContainer } from '../index.styled';\nimport TableHeader from '../TableHeader';\nimport { TableContainer } from '../Tables.styles';\nimport { getColumns } from './columns';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\nimport { generateDataWithId, getSyncedData } from '../utils';\n\ntype Props = {\n  isGstr1A?: boolean;\n  warningMessage?: boolean;\n};\n\nconst DocumentSummary = ({ isGstr1A, warningMessage }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const { themeMode } = useAppContext();\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/document-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps) => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) => (item.id === newRecord.id ? newRecord : item)),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      document_type: undefined,\n      from: 0,\n      to: 0,\n      totnum: 0,\n      cancel: 0,\n      net_issue: 0,\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onDeleteClick = (id: number) => {\n    const syncedData = getSyncedData(tableData, showOnlyData);\n    setData({ data: syncedData.filter((item) => item.id !== id) });\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    postDataApi('gst-returns/gstr1/document-summary/', infoViewContext, {\n      data: allData,\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        infoViewContext.showMessage(response.message);\n        reCallAPI();\n        setEditEnabled(false);\n        // onMPGSTR1DocSummaryEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/doc-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n        // onMPGSTR1DocSummaryDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/doc-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1DocSummaryDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n  const style =\n    themeMode === ThemeMode.DARK\n      ? {\n          background: appDarkTable.headerBgColor,\n          color: appDarkTable.textColor,\n          border: `1px solid ${appDarkTable.borderColor}`,\n        }\n      : {\n          background: appTable.headerBgColor,\n          color: appTable.textColor,\n          border: `1px solid ${appTable.borderColor}`,\n        };\n  const isDataPresent = loading || Array.isArray(apiData?.data);\n\n  return (\n    <TableContainer id='document-summary'>\n      <TableHeader\n        heading='Document Summary'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isDatainProgress={!isDataPresent}\n        isGSTR1A={isGstr1A || false}\n      />\n      {warningMessage && (\n        <Alert\n          message={\n            'For more than 10,000 invoices, please regenerate Document Summary to view latest summary!'\n          }\n          type={'warning'}\n          showIcon\n          style={{ marginBottom: 20, width: 'fit-content', paddingRight: 20 }}\n        />\n      )}\n      {isDataPresent ? (\n        <AppTable\n          rowKey='id'\n          loading={loading}\n          dataSource={showOnlyData}\n          onChange={handleTableChange}\n          columns={getColumns(isEditEnabled, onValueChange, onDeleteClick)}\n          pagination={false}\n        />\n      ) : (\n        <StyledContainer style={style}>\n          <span style={{ fontSize: 16 }}>{apiData.message}</span>\n        </StyledContainer>\n      )}\n    </TableContainer>\n  );\n};\n\nexport default React.memo(DocumentSummary);\n"
          },
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/HSNSummary/index.tsx",
            "content": "import { ThemeMode } from '@mi/constants/AppEnums';\nimport { useAppContext } from '@mi/context/AppContextProvider';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { appDarkTable, appTable } from '@mi/db/global/theme';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport {\n  Gstr1InputIdKeys,\n  Gstr1SummaryTableProps,\n} from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { Alert } from 'antd';\nimport React, { useEffect, useState } from 'react';\nimport { StyledContainer } from '../index.styled';\nimport TableHeader from '../TableHeader';\nimport { TableContainer } from '../Tables.styles';\nimport { getColumns } from './columns';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\nimport { generateDataWithId, getSyncedData } from '../utils';\n\ntype Props = {\n  isGstr1A?: boolean;\n  warningMessage?: boolean;\n};\n\nconst HSNSummary = ({ isGstr1A, warningMessage = false}: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/hsn-summary/',\n    undefined,\n    {\n      ...(isGstr1A ? { data_type: 'GSTR1A' } : {})}\n  );\n  const { themeMode } = useAppContext();\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      hsn_sc: '',\n      item_name: '',\n      uqc: '',\n      qty: 0,\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onDeleteClick = (id: number) => {\n    const syncedData = getSyncedData(tableData, showOnlyData);\n    setData({ data: syncedData.filter((item) => item.id !== id) });\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const updatedTableData = allData.map((item) => {\n      // for (const key as Gstr1InputIdKeys in item) {\n      for (const key in item) {\n        if (item[key as Gstr1InputIdKeys] === null) {\n          item = { ...item, [key as Gstr1InputIdKeys]: '' };\n        }\n      }\n      return item;\n    });\n    postDataApi('gst-returns/gstr1/hsn-summary/', infoViewContext, {\n      data: updatedTableData,\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        reCallAPI();\n        setEditEnabled(false);\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1HSNEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/hsn-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1HSNDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/hsn-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1HSNDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  const style =\n    themeMode === ThemeMode.DARK\n      ? {\n          background: appDarkTable.headerBgColor,\n          color: appDarkTable.textColor,\n          border: `1px solid ${appDarkTable.borderColor}`,\n        }\n      : {\n          background: appTable.headerBgColor,\n          color: appTable.textColor,\n          border: `1px solid ${appTable.borderColor}`,\n        };\n  const isDataPresent = loading || Array.isArray(apiData?.data);\n  return (\n    <TableContainer id='hsn-summary'>\n      <TableHeader\n        heading={`HSN Summary`}\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isDatainProgress={!isDataPresent}\n        isGSTR1A={isGstr1A || false}\n      />\n\n      {warningMessage && (\n        <Alert\n          message={\n            'For more than 10,000 invoices, please regenerate HSN Summary to view latest summary!'\n          }\n          type={'warning'}\n          showIcon\n          style={{ marginBottom: 20, width: 'fit-content', paddingRight: 20 }}\n        />\n      )}\n      {isDataPresent ? (\n        <AppTable\n          rowKey='id'\n          loading={loading}\n          dataSource={showOnlyData}\n          onChange={handleTableChange}\n          columns={getColumns(isEditEnabled, onValueChange, onDeleteClick)}\n          pagination={false}\n        />\n      ) : (\n        <StyledContainer style={style}>\n          <span style={{ fontSize: 16 }}>{apiData.message}</span>\n        </StyledContainer>\n      )}\n    </TableContainer>\n  );\n};\n\nexport default React.memo(HSNSummary);\n"
          },
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/SuppliesEcom/index.tsx",
            "content": "import React, { useEffect, useState } from 'react';\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport type { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport AppTable from '@mi/shared/AppTable';\nimport { GSTINRegx } from '@mi/constants/Regex';\nimport { messagesMapping } from '../AmendedSuppliesEcom';\nimport {\n  generateDataWithId,\n  getSupecoDecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isGstr1A?: boolean;\n};\n\nconst SuppliesEcom = ({ isGstr1A}: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/supeco-summary/?is_amended=N',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (Array.isArray(apiData?.data)) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: any, key = 'cgst') => {\n    const newValues = {\n      ...newRecord,\n      net_val:\n        newRecord.igst +\n        newRecord.cess +\n        newRecord.suppval +\n        (key === 'cgst' ? 2 * newRecord.cgst : 2 * newRecord.sgst),\n      cgst: key === 'cgst' ? newRecord.cgst : newRecord.sgst,\n      sgst: key === 'sgst' ? newRecord.sgst : newRecord.cgst,\n    };\n    setShowOnlyData((prevState) =>\n      Array.isArray(prevState)\n        ? prevState.map((item) => (item.id === newRecord.id ? newValues : item))\n        : newValues,\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: Array.isArray(tableData) ? tableData.length + 1 : 1,\n      igst: 0,\n      cgst: 0,\n      sgst: 0,\n      cess: 0,\n      suppval: 0,\n      net_val: 0,\n      supeco_section: '',\n      etin: '',\n    };\n\n    setTableData((prevState) =>\n      Array.isArray(prevState) ? [...prevState, newRow] : [newRow],\n    );\n    setShowOnlyData((prevState) =>\n      Array.isArray(prevState) ? [...prevState, newRow] : [newRow],\n    );\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    let key = '';\n    let finalTableData: Gstr1SummaryTableProps[] = [];\n    const allData = getSyncedData(tableData, showOnlyData);\n    for (const item of allData) {\n      if (item?.supeco_section === '') {\n        key = 'supeco';\n        break;\n      } else if (!(item.etin && GSTINRegx.test(item.etin))) {\n        key = 'etin';\n        break;\n      }\n\n      finalTableData = finalTableData.concat({\n        ...getSupecoDecimalData(item),\n        omon: item.omon ? item.omon.replace('-', '') : '',\n      });\n    }\n\n    if (key === '')\n      postDataApi('gst-returns/gstr1/supeco-summary/', infoViewContext, {\n        data: finalTableData,\n        is_amended: 'N',\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      })\n        .then((response) => {\n          infoViewContext.showMessage(response.message);\n          reCallAPI();\n          setEditEnabled(false);\n          // onMPGSTR1TxpdEdit(response);\n        })\n        .catch((error) => {\n          infoViewContext.fetchError(error.message);\n        });\n    else {\n      infoViewContext.fetchError(\n        messagesMapping[key as keyof typeof messagesMapping],\n      );\n    }\n  };\n\n  const onDeleteClick = (id: number) => {\n    const syncedData = getSyncedData(tableData, showOnlyData);\n    setData({\n      data: syncedData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi(\n      'gst-returns/gstr1/supeco-summary/?is_amended=N',\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n\n        // reCallAPI();\n        // onMPGSTR1TxpdDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(\n      `gst-returns/gstr1/supeco-summary/download/?is_amended=N`,\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1TxpdDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  return (\n    <TableContainer id='supplies-ecom'>\n      <TableHeader\n        heading='Supplies made through the E-Commerce Operators'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n\n      />\n\n      <AppTable\n        rowKey='id'\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(SuppliesEcom);\n"
          },
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/VoucherAmendedSummary/index.tsx",
            "content": "import React, { useEffect, useState } from 'react';\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\n// import { onMPGSTR1AdvaEdit } from '@mi/services/mixpanel';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport AppTable from '@mi/shared/AppTable';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  isGstr1A?: boolean;\n};\n\nconst VoucherAmendedSummary = ({ isGstr1A, isSez }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/voucher-amended-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (apiData?.data) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      pos: '',\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n      original_month: '',\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => getGstr1DecimalData(row));\n\n    postDataApi(\n      'gst-returns/gstr1/voucher-summary/?isamended=y&invoice_type=performa&voucher_type=Receipt Voucher',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        reCallAPI();\n        setEditEnabled(false);\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1AdvaEdit(response.message);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteClick = (id: number) => {\n    const syncedData = getSyncedData(tableData, showOnlyData);\n    setData({\n      data: syncedData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/vcha-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n        // reCallAPI();\n        // onMPGSTR1AdvaDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(\n      `gst-returns/gstr1/voucher-amended-summary/download/`,\n      infoViewContext,\n      { data_type: isGstr1A ? 'GSTR1A' : null },\n    )\n      .then((response) => {\n        if (response.success) {\n          if (response.download_url) {\n            const fileName = getFileName(response.download_url);\n            downloadFileData(fileName, infoViewContext, {\n              url: response.download_url,\n            });\n          }\n          // onMPGSTR1AdvaDownload(response);\n        } else {\n          infoViewContext.fetchError(response.message);\n        }\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n\n  return (\n    <TableContainer id='voucherAmen-summary'>\n      <TableHeader\n        heading='Amended Advance Received in Current Tax Period'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n      />\n\n      <AppTable\n        rowKey='id'\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick, isSez)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(VoucherAmendedSummary);\n"
          },
