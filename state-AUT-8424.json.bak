            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/ViewData/SummaryTables/VoucherSummary/index.tsx",
            "content": "import React, { useEffect, useState } from 'react';\n\nimport { TableContainer } from '../Tables.styles';\nimport TableHeader from '../TableHeader';\nimport { getColumns } from './columns';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport {\n  deleteDataApi,\n  downloadFileData,\n  getDataApi,\n  postDataApi,\n  useGetDataApi,\n} from '@mi/hooks/APIHooks';\nimport { Gstr1SummaryTableProps } from '@mi/models/GstReturns/Gstr1/SummaryTable';\nimport { getFileName } from '@mi/helpers/FileHelper';\nimport AppTable from '@mi/shared/AppTable';\nimport {\n  generateDataWithId,\n  getGstr1DecimalData,\n  getSyncedData,\n} from '../utils';\nimport { applyLocalFilterAndSort } from '@mi/helpers/TableHelper';\n\ntype Props = {\n  isSez: boolean;\n  isGstr1A?: boolean;\n};\n\nconst VoucherSummary = ({ isGstr1A, isSez }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [tableData, setTableData] = useState<Gstr1SummaryTableProps[]>([]);\n  const [showOnlyData, setShowOnlyData] = useState<Gstr1SummaryTableProps[]>(\n    [],\n  );\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const [filters, setFilters] = useState({});\n  const [sorter, setSorter] = useState({});\n  const [{ apiData, loading }, { reCallAPI, setData }] = useGetDataApi<\n    Gstr1SummaryTableProps[]\n  >(\n    'gst-returns/gstr1/voucher-summary/',\n    undefined,\n    isGstr1A ? { data_type: 'GSTR1A' } : {},\n  );\n\n  useEffect(() => {\n    if (apiData?.data) {\n      const tableData = generateDataWithId(apiData.data);\n      setTableData(tableData);\n      setShowOnlyData(applyLocalFilterAndSort(tableData, filters, sorter));\n      infoViewContext.fetchSuccess();\n    }\n  }, [apiData?.data]);\n\n  const onCancelClick = () => {\n    setTableData(generateDataWithId(apiData.data));\n    setShowOnlyData(applyLocalFilterAndSort(apiData.data, filters, sorter));\n    setEditEnabled(false);\n  };\n\n  const onValueChange = (newRecord: Gstr1SummaryTableProps, key = 'camt') => {\n    setShowOnlyData((prevState) =>\n      prevState.map((item) =>\n        item.id === newRecord.id\n          ? key === 'camt'\n            ? { ...newRecord, samt: newRecord.camt }\n            : { ...newRecord, camt: newRecord.samt }\n          : item,\n      ),\n    );\n  };\n\n  const onAddRowClick = () => {\n    const newRow = {\n      id: tableData.length + 1,\n      pos: '',\n      rt: 0,\n      txval: 0,\n      iamt: 0,\n      camt: 0,\n      samt: 0,\n      csamt: 0,\n    };\n\n    setTableData((prevState) => [...prevState, newRow]);\n    setShowOnlyData((prevState) => [...prevState, newRow]);\n\n    setEditEnabled(true);\n  };\n\n  const onDeleteClick = (id: number) => {\n    const syncedData = getSyncedData(tableData, showOnlyData);\n    setData({\n      data: syncedData.filter((item) => item.id !== id),\n      invoice_count: apiData?.invoice_count,\n    });\n  };\n\n  const onSaveChanges = () => {\n    const allData = getSyncedData(tableData, showOnlyData);\n    const postData = allData?.map((row) => getGstr1DecimalData(row));\n\n    postDataApi(\n      'gst-returns/gstr1/voucher-summary/?isamended=n&invoice_type=performa&voucher_type=Receipt Voucher',\n      infoViewContext,\n      {\n        data: postData,\n        invoice_count: apiData?.invoice_count,\n        data_type: isGstr1A ? 'GSTR1A' : null,\n      },\n    )\n      .then((response) => {\n        reCallAPI();\n        setEditEnabled(false);\n        infoViewContext.showMessage(response.message);\n\n        // onMPGSTR1AdvEdit(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDeleteData = () => {\n    deleteDataApi('gst-returns/gstr1/vch-data/', infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        setData({ data: [] });\n        onRefreshClick();\n        infoViewContext.showMessage(response.message);\n\n        // reCallAPI();\n        // onMPGSTR1AdvDelete(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onDownloadCLick = () => {\n    getDataApi(`gst-returns/gstr1/voucher-summary/download/`, infoViewContext, {\n      data_type: isGstr1A ? 'GSTR1A' : null,\n    })\n      .then((response) => {\n        if (response.download_url) {\n          const fileName = getFileName(response.download_url);\n          downloadFileData(fileName, infoViewContext, {\n            url: response.download_url,\n          });\n        }\n        // onMPGSTR1AdvDownload(response);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n      });\n  };\n\n  const onRefreshClick = () => {\n    infoViewContext.fetchStart();\n    reCallAPI();\n  };\n\n\n\n  const handleTableChange = (pagination = false, filters: any, sorter: any) => {\n    const latestData = getSyncedData(tableData, showOnlyData);\n    setTableData(latestData);\n    setShowOnlyData(applyLocalFilterAndSort(latestData, filters, sorter));\n    setFilters(filters);\n    setSorter(sorter);\n  };\n  return (\n    <TableContainer id='voucher-summary'>\n      <TableHeader\n        heading='Advance Received in Current Tax Period'\n        isEditEnabled={isEditEnabled}\n        onAddRowClick={onAddRowClick}\n        onCancelClick={onCancelClick}\n        setEditEnabled={setEditEnabled}\n        onSaveChanges={onSaveChanges}\n        onRefreshClick={onRefreshClick}\n        onDeleteData={onDeleteData}\n        onDownloadCLick={onDownloadCLick}\n        isGSTR1A={isGstr1A || false}\n      />\n\n      <AppTable\n        rowKey='id'\n        loading={loading}\n        dataSource={showOnlyData}\n        onChange={handleTableChange}\n        columns={getColumns(isEditEnabled, onValueChange, onDeleteClick, isSez)}\n        pagination={false}\n      />\n    </TableContainer>\n  );\n};\n\nexport default React.memo(VoucherSummary);\n"
