      "codeChanges": {
        "changes": [
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr1/UploadData/index.tsx",
            "content": "import { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { useCurrentBusiness, useUserPermission } from '@mi/hooks/AuthHooks';\nimport { Form, notification } from 'antd';\nimport { Key, useCallback, useEffect, useMemo, useRef, useState } from 'react';\nimport { Beforeunload } from 'react-beforeunload';\nimport TabBadge from '../../components/TabBadge';\nimport CompareData from './CompareData';\nimport {\n  UploadDataContainer,\n  UploadDataNotificationContainer,\n} from './index.styled';\nimport PendingUpload from './PendingUpload';\nimport UploadHistory from './UploadHistory';\n\nimport AppTabs from '@mi/components/AppTabs';\nimport AppViewWrapper from '@mi/components/AppViewWrapper';\nimport { APPModules } from '@mi/constants/AppEnums';\nimport { getDataApi } from '@mi/hooks/APIHooks';\nimport useManagePermission from '@mi/hooks/useManagePermission';\nimport { UploadStatusProps } from '@mi/models/GstReturns/Gstr1/Prepare';\nimport { GSTR1Access } from '@mi/permissions/returns/GSTR1';\nimport { useUploadDataContext } from './Context/UploadDataContext';\n\nconst MAX_POLL_COUNT = 120;\n\nexport type FilterProps = {\n  search: string;\n  invoice_type: string | null;\n};\n\ntype Props = {\n  isGstr1A?: boolean;\n  isButtonDisabled?: boolean;\n};\nexport const UploadGSTR1Data = ({\n  isGstr1A = false,\n  isButtonDisabled,\n}: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [selectedIds, setSelectedIds] = useState<Key[]>([]);\n  const [activeTab, setActiveTab] = useState('pending_upload');\n  const [tabCount, setTabsCount] = useState<number | null>(null);\n  const [invoiceType, setInvoiceType] = useState<string | null>(null);\n  const [viewType, setViewType] = useState('invoice');\n  const [uploadId, setUploadId] = useState<string | null>(null);\n  const [filterData, setFilterData] = useState<FilterProps | null>(null);\n  const [reloadPendingUpload, setReloadPendingUpload] = useState(false);\n  const [successAlerts, setSuccessAlerts] = useState<string[]>([]);\n  const [errorAlerts, setErrorAlerts] = useState<string[]>([]);\n  const [api, contextHolder] = notification.useNotification();\n  const [form] = Form.useForm();\n  const { isPermissionAllowed } = useManagePermission();\n  const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);\n  const pollCountRef = useRef(0);\n\n  const getUploadStatus = useCallback((id: string) => {\n    getDataApi<UploadStatusProps>(\n      'gst-returns/gstr1/upload-status/',\n      infoViewContext,\n      { id, data_type: isGstr1A ? 'GSTR1A' : null },\n      true,\n    )\n      .then((response) => {\n        const status = response.data.status;\n\n        if (status === 'done' || status === 'failed' || status === 'error') {\n          setUploadId(null);\n          setReloadPendingUpload(true);\n          sessionStorage.removeItem('upload_id');\n\n          if (status === 'done') {\n            const success: string[] = [];\n            const errors: string[] = [];\n\n            response.data?.alerts?.forEach((alert) => {\n              if (alert?.status) {\n                success.push(\n                  `${alert?.invoice_type?.toUpperCase()}: ${alert?.message}`,\n                );\n              } else {\n                errors.push(\n                  `${alert?.invoice_type?.toUpperCase()}: ${alert?.message}`,\n                );\n              }\n            });\n\n            setSuccessAlerts(success);\n            setErrorAlerts(errors);\n          }\n        }\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n        setUploadId(null);\n        setReloadPendingUpload(true);\n        sessionStorage.removeItem('upload_id');\n      });\n  }, []);\n\n  useEffect(() => {\n    const upload_id = sessionStorage.getItem('upload_id');\n    if (upload_id) setUploadId(upload_id);\n  }, []);\n\n  useEffect(() => {\n    if (reloadPendingUpload) {\n      setTimeout(() => {\n        setReloadPendingUpload(false);\n      }, 1000);\n    }\n  }, [reloadPendingUpload]);\n\n  useEffect(() => {\n    if (successAlerts.length > 0)\n      api.success({\n        message: 'Success',\n        description: (\n          <UploadDataNotificationContainer>\n            {successAlerts.map((alertMessage, index) => (\n              <p key={index}>{alertMessage}</p>\n            ))}\n          </UploadDataNotificationContainer>\n        ),\n        duration: 0,\n        onClose: () => setSuccessAlerts([]),\n      });\n  }, [successAlerts]);\n\n  useEffect(() => {\n    if (errorAlerts.length > 0)\n      api.error({\n        message: 'Errors',\n        description: (\n          <UploadDataNotificationContainer>\n            {errorAlerts.map((alertMessage, index) => (\n              <p key={index}>{alertMessage}</p>\n            ))}\n          </UploadDataNotificationContainer>\n        ),\n        duration: 0,\n        onClose: () => setErrorAlerts([]),\n      });\n  }, [errorAlerts]);\n\n  useEffect(() => {\n    setSelectedIds([]);\n  }, [activeTab, filterData]);\n\n  useEffect(() => {\n    if (uploadId) {\n      pollCountRef.current = 0;\n      getUploadStatus(uploadId);\n\n      timerRef.current = setInterval(() => {\n        pollCountRef.current += 1;\n        if (pollCountRef.current >= MAX_POLL_COUNT) {\n          setUploadId(null);\n          setReloadPendingUpload(true);\n          sessionStorage.removeItem('upload_id');\n          return;\n        }\n        getUploadStatus(uploadId);\n      }, 1000 * 5);\n    }\n\n    return () => {\n      if (timerRef.current) {\n        clearInterval(timerRef.current);\n        timerRef.current = null;\n      }\n    };\n  }, [uploadId, getUploadStatus]);\n\n  const items = useMemo(() => {\n    const items = [\n      {\n        key: 'pending_upload',\n        label: (\n          <TabBadge\n            tabTitle='Pending for upload'\n            tabBadge={viewType !== 'invoice' ? 0 : tabCount || 0}\n          />\n        ),\n        children: activeTab === 'pending_upload' && (\n          <PendingUpload\n            form={form}\n            isGstr1A={isGstr1A}\n            selectedIds={selectedIds}\n            setSelectedIds={setSelectedIds}\n            setTabsCount={setTabsCount}\n            viewType={viewType}\n            isButtonDisabled={isButtonDisabled || false}\n            setViewType={setViewType}\n            reloadData={reloadPendingUpload}\n            setInvoiceType={setInvoiceType}\n            setExportFilter={setFilterData}\n            setUploadId={setUploadId}\n            invoiceType={invoiceType!}\n            uploadId={uploadId}\n          />\n        ),\n      },\n    ];\n    if (isPermissionAllowed(APPModules.GSTR1, GSTR1Access.UploadHistoryView))\n      items.push({\n        key: 'history',\n        label: <TabBadge tabTitle='Upload History' />,\n        children: activeTab === 'history' && (\n          <UploadHistory\n            isGstr1A={isGstr1A}\n            uploadId={uploadId!}\n            isButtonDisabled={isButtonDisabled}\n            setReloadPendingUpload={setReloadPendingUpload}\n          />\n        ),\n      });\n    isPermissionAllowed(APPModules.GSTR1, GSTR1Access.CompareDataView);\n    items.push({\n      key: 'compare',\n      label: <TabBadge tabTitle='Compare Data' />,\n      children: activeTab === 'compare' && (\n        <CompareData isGstr1A={isGstr1A} isButtonDisabled={isButtonDisabled} />\n      ),\n    });\n    return items;\n  }, [\n    activeTab,\n    isGstr1A,\n    reloadPendingUpload,\n    selectedIds,\n    tabCount,\n    viewType,\n    uploadId,\n  ]);\n\n  return (\n    <UploadDataContainer>\n      {!!uploadId && (\n        <Beforeunload onBeforeunload={() => 'You’ll lose your data!'} />\n      )}\n      <AppTabs\n        type='card'\n        activeKey={activeTab}\n        onTabClick={setActiveTab}\n        items={items}\n      />\n      {contextHolder}\n    </UploadDataContainer>\n  );\n};\n\nexport default UploadGSTR1Data;\n"
          },
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr6/UploadData/index.tsx",
            "content": "import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';\nimport { UploadDataContainer, UploadDataNotificationContainer } from './index.styled';\n\nimport AppTabs from '@mi/components/AppTabs';\nimport { APPModules } from '@mi/constants/AppEnums';\nimport { GSTR6Access } from '@mi/constants/permissions/app/returns/GSTR6';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { getDataApi } from '@mi/hooks/APIHooks';\nimport useManagePermission from '@mi/hooks/useManagePermission';\nimport { UploadStatusProps } from '@mi/models/GstReturns/Gstr1/Prepare';\nimport { notification } from 'antd';\nimport { Beforeunload } from 'react-beforeunload';\nimport TabBadge from '../../components/TabBadge';\nimport PendingUpload from './PendingUpload';\nimport UploadHistory from './UploadHistory';\n\nexport type Gstr6UploadFilterProps = {\n  search: string;\n  invoice_type: string | null;\n};\n\nconst MAX_POLL_COUNT = 120;\n\nexport const UploadGSTR6Data = () => {\n  const infoViewContext = useInfoViewActionsContext();\n\n  const [activeTab, setActiveTab] = useState('pending_upload');\n  const [tabCount, setTabsCount] = useState<number | null>(null);\n  const [uploadId, setUploadId] = useState<string | null>(null);\n  const [reloadPendingUpload, setReloadPendingUpload] = useState(false);\n  const [successAlerts, setSuccessAlerts] = useState<string[]>([]);\n  const [errorAlerts, setErrorAlerts] = useState<string[]>([]);\n  const { isPermissionAllowed } = useManagePermission();\n  const [api, contextHolder] = notification.useNotification();\n  const hasUploadPermission = isPermissionAllowed(\n    APPModules.GSTR6,\n    GSTR6Access.UploadHistory,\n  );\n  const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);\n  const pollCountRef = useRef(0);\n\n  const getUploadStatus = useCallback((id: string) => {\n    getDataApi<UploadStatusProps>(\n      'gst-returns/gstr6/upload/status/',\n      infoViewContext,\n      { id },\n      true,\n    )\n      .then((response) => {\n        const status = response.data.status;\n\n        if (status === 'done' || status === 'failed' || status === 'error') {\n          setUploadId(null);\n          setReloadPendingUpload(true);\n          sessionStorage.removeItem('upload_id');\n\n          if (status === 'done') {\n            const success: string[] = [];\n            const errors: string[] = [];\n\n            response.data?.alerts?.forEach((alert) => {\n              if (alert?.status) {\n                success.push(\n                  `${alert?.invoice_type?.toUpperCase()}: ${alert?.message}`,\n                );\n              } else {\n                errors.push(\n                  `${alert?.invoice_type?.toUpperCase()}: ${alert?.message}`,\n                );\n              }\n            });\n\n            setSuccessAlerts(success);\n            setErrorAlerts(errors);\n          }\n        }\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n        setUploadId(null);\n        setReloadPendingUpload(true);\n        sessionStorage.removeItem('upload_id');\n      });\n  }, []);\n\n  useEffect(() => {\n    const upload_id = sessionStorage.getItem('upload_id');\n    if (upload_id) setUploadId(upload_id);\n  }, []);\n\n  useEffect(() => {\n    if (reloadPendingUpload) {\n      setTimeout(() => {\n        setReloadPendingUpload(false);\n      }, 1000);\n    }\n  }, [reloadPendingUpload]);\n\n  useEffect(() => {\n    if (successAlerts.length > 0)\n      api.success({\n        message: 'Success',\n        description: (\n          <UploadDataNotificationContainer>\n            {successAlerts.map((alertMessage, index) => (\n              <p key={index}>{alertMessage}</p>\n            ))}\n          </UploadDataNotificationContainer>\n        ),\n        duration: 0,\n        onClose: () => setSuccessAlerts([]),\n      });\n  }, [successAlerts]);\n\n  useEffect(() => {\n    if (errorAlerts.length > 0)\n      api.error({\n        message: 'Errors',\n        description: (\n          <UploadDataNotificationContainer>\n            {errorAlerts.map((alertMessage, index) => (\n              <p key={index}>{alertMessage}</p>\n            ))}\n          </UploadDataNotificationContainer>\n        ),\n        duration: 0,\n        onClose: () => setErrorAlerts([]),\n      });\n  }, [errorAlerts]);\n\n\n\n  useEffect(() => {\n    if (uploadId) {\n      pollCountRef.current = 0;\n      getUploadStatus(uploadId);\n\n      timerRef.current = setInterval(() => {\n        pollCountRef.current += 1;\n        if (pollCountRef.current >= MAX_POLL_COUNT) {\n          setUploadId(null);\n          setReloadPendingUpload(true);\n          sessionStorage.removeItem('upload_id');\n          return;\n        }\n        getUploadStatus(uploadId);\n      }, 1000 * 5);\n    }\n\n    return () => {\n      if (timerRef.current) {\n        clearInterval(timerRef.current);\n        timerRef.current = null;\n      }\n    };\n  }, [uploadId, getUploadStatus]);\n\n  const items = useMemo(\n    () => [\n      {\n        key: 'pending_upload',\n        label: (\n          <TabBadge tabTitle='Pending for upload' tabBadge={tabCount || 0} />\n        ),\n        children: activeTab === 'pending_upload' && (\n          <PendingUpload\n            setTabsCount={setTabsCount}\n            reloadPendingUpload={reloadPendingUpload}\n            uploadId={uploadId}\n            setUploadId={setUploadId}\n            setReloadPendingUpload={setReloadPendingUpload}\n          />\n        ),\n      },\n      {\n        key: 'history',\n        label: <TabBadge tabTitle='Upload History' />,\n        children: activeTab === 'history' && (\n          <UploadHistory uploadId={uploadId!} />\n        ),\n      },\n    ],\n    [\n      reloadPendingUpload,\n      tabCount,\n      // selectedIds,\n      activeTab,\n      // refreshData,\n      uploadId,\n    ],\n  );\n\n  return (\n    <UploadDataContainer>\n      {!!uploadId && (\n        <Beforeunload onBeforeunload={() => 'You’ll lose your data!'} />\n      )}\n      <AppTabs\n        type='card'\n        activeKey={activeTab}\n        onTabClick={setActiveTab}\n        // tabBarExtraContent={getTabHeader()}\n        items={items}\n      />\n      {contextHolder}\n    </UploadDataContainer>\n  );\n};\n\nexport default React.memo(UploadGSTR6Data);\n"
          },
          {
            "action": "update",
            "file_path": "libs/smb/src/lib/gst/Gstr7/UploadData/index.tsx",
            "content": "import { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { notification } from 'antd';\nimport { useCallback, useEffect, useMemo, useRef, useState } from 'react';\nimport { Beforeunload } from 'react-beforeunload';\nimport PendingUpload from './PendingUpload';\n\nimport AppTabs from '@mi/components/AppTabs';\nimport { APPModules } from '@mi/constants/AppEnums';\nimport { getDataApi } from '@mi/hooks/APIHooks';\nimport useManagePermission from '@mi/hooks/useManagePermission';\nimport { UploadStatusProps } from '@mi/models/GstReturns/Gstr1/Prepare';\nimport { GSTR1Access } from '@mi/permissions/returns/GSTR1';\nimport { UploadDataContainer, UploadDataNotificationContainer } from '../../Gstr1/UploadData/index.styled';\nimport UploadHistory from '../ViewData/UploadHistory';\n\nconst MAX_POLL_COUNT = 120;\n\nexport type FilterProps = {\n  search: string;\n  invoice_type: string | null;\n};\n\ntype Props = {\n  isGstr1A?: boolean;\n  isButtonDisabled?: boolean;\n};\nexport const UploadGSTR7Data = ({ isButtonDisabled }: Props) => {\n  const infoViewContext = useInfoViewActionsContext();\n  const [activeTab, setActiveTab] = useState('pending_upload');\n  const [viewType, setViewType] = useState('detail');\n  const [uploadId, setUploadId] = useState<string | null>(null);\n  const [successAlerts, setSuccessAlerts] = useState<string[]>([]);\n  const [errorAlerts, setErrorAlerts] = useState<string[]>([]);\n  const { isPermissionAllowed } = useManagePermission();\n  const [api, contextHolder] = notification.useNotification();\n  const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);\n  const pollCountRef = useRef(0);\n\n  const getUploadStatus = useCallback((id: string) => {\n    getDataApi<UploadStatusProps>(\n      'gst-returns/gstr7/upload/status/',\n      infoViewContext,\n      { id },\n      true,\n    )\n      .then((response) => {\n        const status = response.data.status;\n\n        if (status === 'done' || status === 'failed' || status === 'error') {\n          setUploadId(null);\n          sessionStorage.removeItem('upload_id');\n\n          if (status === 'done') {\n            const success: string[] = [];\n            const errors: string[] = [];\n\n            response.data?.alerts?.forEach((alert) => {\n              if (alert?.status) {\n                success.push(\n                  `${alert?.invoice_type?.toUpperCase()}: ${alert?.message}`,\n                );\n              } else {\n                errors.push(\n                  `${alert?.invoice_type?.toUpperCase()}: ${alert?.message}`,\n                );\n              }\n            });\n\n            setSuccessAlerts(success);\n            setErrorAlerts(errors);\n          }\n        }\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n        setUploadId(null);\n        sessionStorage.removeItem('upload_id');\n      });\n  }, []);\n\n  useEffect(() => {\n    const upload_id = sessionStorage.getItem('upload_id');\n    if (upload_id) setUploadId(upload_id);\n  }, []);\n\n  useEffect(() => {\n    if (successAlerts.length > 0)\n      api.success({\n        message: 'Success',\n        description: (\n          <UploadDataNotificationContainer>\n            {successAlerts.map((alertMessage, index) => (\n              <p key={index}>{alertMessage}</p>\n            ))}\n          </UploadDataNotificationContainer>\n        ),\n        duration: 0,\n        onClose: () => setSuccessAlerts([]),\n      });\n  }, [successAlerts]);\n\n  useEffect(() => {\n    if (errorAlerts.length > 0)\n      api.error({\n        message: 'Errors',\n        description: (\n          <UploadDataNotificationContainer>\n            {errorAlerts.map((alertMessage, index) => (\n              <p key={index}>{alertMessage}</p>\n            ))}\n          </UploadDataNotificationContainer>\n        ),\n        duration: 0,\n        onClose: () => setErrorAlerts([]),\n      });\n  }, [errorAlerts]);\n\n  useEffect(() => {\n    if (uploadId) {\n      pollCountRef.current = 0;\n      getUploadStatus(uploadId);\n\n      timerRef.current = setInterval(() => {\n        pollCountRef.current += 1;\n        if (pollCountRef.current >= MAX_POLL_COUNT) {\n          setUploadId(null);\n          sessionStorage.removeItem('upload_id');\n          return;\n        }\n        getUploadStatus(uploadId);\n      }, 1000 * 5);\n    }\n\n    return () => {\n      if (timerRef.current) {\n        clearInterval(timerRef.current);\n        timerRef.current = null;\n      }\n    };\n  }, [uploadId, getUploadStatus]);\n\n  const items = useMemo(() => {\n    const items = [\n      {\n        key: 'pending_upload',\n        label: 'Pending for upload',\n        children: activeTab === 'pending_upload' && (\n          <PendingUpload\n            viewType={viewType}\n            isButtonDisabled={isButtonDisabled || false}\n            setViewType={setViewType}\n            setUploadId={setUploadId}\n            uploadId={uploadId}\n          />\n        ),\n      },\n    ];\n    if (isPermissionAllowed(APPModules.GSTR1, GSTR1Access.UploadHistoryView))\n      items.push({\n        key: 'history',\n        label: 'Upload History',\n        children: activeTab === 'history' && (\n          <UploadHistory uploadId={uploadId!} />\n        ),\n      });\n    return items;\n  }, [\n    activeTab,\n    viewType,\n    uploadId,\n  ]);\n\n  return (\n    <UploadDataContainer>\n      {!!uploadId && (\n        <Beforeunload onBeforeunload={() => 'You’ll lose your data!'} />\n      )}\n      <AppTabs\n        type='card'\n        activeKey={activeTab}\n        onTabClick={setActiveTab}\n        items={items}\n      />\n      {contextHolder}\n    </UploadDataContainer>\n  );\n};\n\nexport default UploadGSTR7Data;\n"
          },
          {
            "action": "update",
            "file_path": "package.json",
            "content": "{\n  \"name\": \"mi\",\n  \"version\": \"0.0.0\",\n  \"license\": \"MIT\",\n  \"scripts\": {},\n  \"private\": true,\n  \"devDependencies\": {\n    \"@nx/eslint-plugin\": \"22.0.4\",\n    \"@nx/jest\": \"^21.2.4\",\n    \"@nx/js\": \"22.0.4\",\n    \"@nx/react\": \"22.0.4\",\n    \"@nx/vite\": \"22.0.4\",\n    \"@nx/workspace\": \"22.0.4\",\n    \"@playwright/test\": \"^1.59.1\",\n    \"@testing-library/react\": \"16.3.0\",\n    \"@types/jest\": \"30.0.0\",\n    \"@types/lodash\": \"4.17.20\",\n    \"@types/node\": \"24.10.1\",\n    \"@types/react\": \"^19.2.6\",\n    \"@types/react-dom\": \"^19.2.3\",\n    \"@types/react-highlight-words\": \"0.20.0\",\n    \"@types/react-is\": \"19.2.0\",\n    \"@types/turndown\": \"^5.0.6\",\n    \"@types/validator\": \"^13.15.10\",\n    \"@typescript-eslint/eslint-plugin\": \"8.47.0\",\n    \"@typescript-eslint/parser\": \"8.47.0\",\n    \"@vitejs/plugin-react\": \"^5.1.1\",\n    \"@vitest/ui\": \"^4.0.10\",\n    \"eslint\": \"9.39.1\",\n    \"eslint-plugin-import\": \"2.32.0\",\n    \"eslint-plugin-jsx-a11y\": \"6.10.2\",\n    \"eslint-plugin-react\": \"7.37.5\",\n    \"eslint-plugin-react-hooks\": \"7.0.1\",\n    \"jest\": \"^29.7.0\",\n    \"jest-canvas-mock\": \"^2.5.2\",\n    \"jest-environment-jsdom\": \"^30.3.0\",\n    \"jsdom\": \"^27.2.0\",\n    \"nx\": \"22.0.4\",\n    \"nx-cloud\": \"19.1.0\",\n    \"prettier\": \"3.6.2\",\n    \"react-refresh\": \"0.18.0\",\n    \"ts-jest\": \"29.4.5\",\n    \"typescript\": \"5.9.3\",\n    \"url-loader\": \"4.1.1\",\n    \"vite\": \"^7.2.2\",\n    \"vite-plugin-dts\": \"4.5.4\",\n    \"vite-plugin-mkcert\": \"^1.17.9\",\n    \"vite-plugin-svgr\": \"^4.5.0\",\n    \"vitest\": \"^4.0.10\"\n  },\n  \"dependencies\": {\n    \"@ant-design/icons\": \"6.1.0\",\n    \"@ant-design/pro-components\": \"3.1.3-1\",\n    \"@azure/msal-browser\": \"^4.26.1\",\n    \"@azure/msal-react\": \"^3.0.21\",\n    \"@builder.io/partytown\": \"0.10.3\",\n    \"@dnd-kit/core\": \"^6.3.1\",\n    \"@dnd-kit/modifiers\": \"^9.0.0\",\n    \"@dnd-kit/sortable\": \"^10.0.0\",\n    \"@faker-js/faker\": \"^10.1.0\",\n    \"@fvilers/disable-react-devtools\": \"^1.3.0\",\n    \"@npmcli/config\": \"^10.4.2\",\n    \"@nx/webpack\": \"22.0.4\",\n    \"@rajesh896/broprint.js\": \"2.2.0\",\n    \"@react-pdf-viewer/core\": \"3.12.0\",\n    \"@react-pdf-viewer/default-layout\": \"3.12.0\",\n    \"@sentry/react\": \"^10.25.0\",\n    \"@sentry/tracing\": \"7.120.4\",\n    \"@svgr/core\": \"8.1.0\",\n    \"@svgr/rollup\": \"^8.1.0\",\n    \"@swc/core\": \"1.15.2\",\n    \"@turf/turf\": \"^7.3.0\",\n    \"@types/crypto-js\": \"4.2.2\",\n    \"@types/hot-formula-parser\": \"^4.0.4\",\n    \"@types/marked\": \"^5.0.2\",\n    \"@types/react-beforeunload\": \"2.1.5\",\n    \"@types/react-color\": \"^3.0.13\",\n    \"@types/react-copy-to-clipboard\": \"5.0.7\",\n    \"@types/react-slick\": \"^0.23.13\",\n    \"@types/sanitize-html\": \"2.16.0\",\n    \"antd\": \"6.2.3\",\n    \"axios\": \"1.13.2\",\n    \"clsx\": \"2.1.1\",\n    \"core-js\": \"3.46.0\",\n    \"crypto-js\": \"4.2.0\",\n    \"detect-autofill\": \"1.1.4\",\n    \"easymde\": \"^2.20.0\",\n    \"firebase\": \"^12.6.0\",\n    \"fs\": \"^0.0.1-security\",\n    \"get-date-format\": \"0.2.1\",\n    \"hot-formula-parser\": \"^4.0.0\",\n    \"html2canvas\": \"1.4.1\",\n    \"jsencrypt\": \"^3.5.4\",\n    \"jspdf\": \"^3.0.3\",\n    \"jwt-decode\": \"^4.0.0\",\n    \"lodash\": \"4.17.21\",\n    \"mapbox-gl\": \"^3.16.0\",\n    \"marked\": \"^15.0.12\",\n    \"mixpanel-browser\": \"2.72.0\",\n    \"object-assign\": \"4.1.1\",\n    \"pdfjs-dist\": \"^3.11.174\",\n    \"polished\": \"4.3.1\",\n    \"qs\": \"6.14.0\",\n    \"query-string\": \"9.3.1\",\n    \"quill\": \"^2.0.3\",\n    \"react\": \"19.2.0\",\n    \"react-beforeunload\": \"2.6.0\",\n    \"react-color\": \"^2.19.3\",\n    \"react-copy-to-clipboard\": \"5.1.0\",\n    \"react-dnd\": \"^16.0.1\",\n    \"react-dnd-html5-backend\": \"^16.0.1\",\n    \"react-dom\": \"19.2.0\",\n    \"react-draggable\": \"^4.5.0\",\n    \"react-dropzone\": \"^14.3.8\",\n    \"react-error-boundary\": \"^6.0.0\",\n    \"react-ga4\": \"^2.1.0\",\n    \"react-google-charts\": \"5.2.1\",\n    \"react-helmet-async\": \"^2.0.5\",\n    \"react-highlight-words\": \"0.21.0\",\n    \"react-icons\": \"^5.5.0\",\n    \"react-intl\": \"7.1.14\",\n    \"react-is\": \"19.2.0\",\n    \"react-json-pretty\": \"2.2.0\",\n    \"react-otp-input\": \"3.1.1\",\n    \"react-pdf\": \"10.2.0\",\n    \"react-perfect-scrollbar\": \"1.5.8\",\n    \"react-prismazoom\": \"3.3.5\",\n    \"react-qr-code\": \"2.0.18\",\n    \"react-quill\": \"^2.0.0\",\n    \"react-quill-new\": \"^3.6.0\",\n    \"react-responsive\": \"10.0.1\",\n    \"react-router-dom\": \"6.11.2\",\n    \"react-share\": \"5.2.2\",\n    \"react-simplemde-editor\": \"^5.2.0\",\n    \"react-slick\": \"^0.31.0\",\n    \"react-use-websocket\": \"^4.13.0\",\n    \"react-youtube\": \"10.1.0\",\n    \"reaptcha\": \"1.12.1\",\n    \"recharts\": \"3.4.1\",\n    \"regenerator-runtime\": \"0.14.1\",\n    \"sanitize-html\": \"2.17.0\",\n    \"simplebar-react\": \"3.3.2\",\n    \"slick-carousel\": \"^1.8.1\",\n    \"socket.io-client\": \"^4.8.1\",\n    \"style-loader\": \"4.0.0\",\n    \"styled-components\": \"6.1.19\",\n    \"styled-normalize\": \"8.1.1\",\n    \"terser\": \"5.44.1\",\n    \"to-words\": \"4.8.0\",\n    \"tslib\": \"2.8.1\",\n    \"turndown\": \"^7.2.2\",\n    \"util\": \"^0.12.5\",\n    \"validator\": \"^13.15.23\",\n    \"vite-plugin-chunk-split\": \"^0.5.0\",\n    \"webpack-merge\": \"6.0.1\"\n  },\n  \"resolutions\": {\n    \"stylus\": \"^0.55.0\"\n  },\n  \"overrides\": {\n    \"quill\": \"^2.0.3\",\n    \"@jest/reporters\": \"29.7.0\",\n    \"jest-config\": \"29.7.0\",\n    \"jest-circus\": \"29.7.0\",\n    \"jest-runtime\": \"29.7.0\",\n    \"jest-runner\": \"29.7.0\"\n  },\n  \"buildDate\": 1723188751086\n}\n"
