        "libs/smb/src/lib/gst/3B/Details/OutwardInwardSupplies/TableColumns.tsx": "import { AppAmountView } from '@mi/components/helperComponents';\nimport { getAmountColumn, onSortOrder } from '@mi/helpers/TableHelper';\nimport type { ColumnsType } from '@mi/models/MiTable';\nimport type { ThreeBItemProps } from '@mi/models/GstReturns/3B';\nimport { StyledInputNumber } from '../TableWrapper.styled';\n\nexport const getColumns = (\n  isEditEnabled: boolean,\n  updateRecord: (record: ThreeBItemProps) => void,\n): ColumnsType<ThreeBItemProps> => [\n  {\n    title: 'Nature of Supplies',\n    dataIndex: 'nature_of_supplies',\n  },\n  {\n    title: 'Total Taxable Value',\n    dataIndex: 'txval',\n    key: 'txval',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'txval'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            defaultValue={value}\n            onBlur={(e) => {\n              const data = { ...record };\n              data['txval'] = parseFloat(e.target.value) || 0;\n              updateRecord(data);\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n  {\n    title: 'IGST',\n    dataIndex: 'igst',\n    key: 'igst',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'igst'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            defaultValue={value}\n            onBlur={(e) => {\n              const data = { ...record };\n              data['igst'] = parseFloat(e.target.value) || 0;\n              updateRecord(data);\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n  {\n    title: 'CGST',\n    dataIndex: 'cgst',\n    key: 'cgst',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'cgst'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            value={value}\n            onChange={(value) => {\n              const data = { ...record };\n              data['cgst'] = parseFloat(value as string) || 0;\n              updateRecord({ ...data, sgst: data['cgst'] });\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n  {\n    title: 'SGST/UTGST',\n    dataIndex: 'sgst',\n    key: 'sgst',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'sgst'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            value={value}\n            onChange={(value) => {\n              const data = { ...record };\n              data['sgst'] = parseFloat(value as string) || 0;\n              updateRecord({ ...data, cgst: data['sgst'] });\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n  {\n    title: 'CESS',\n    dataIndex: 'cess',\n    key: 'cess',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'cess'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            defaultValue={value}\n            onBlur={(e) => {\n              const data = { ...record };\n              data['cess'] = parseFloat(e.target.value) || 0;\n              updateRecord(data);\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n];\n",
        "libs/smb/src/lib/gst/3B/Details/OutwardInwardSupplies/index.tsx": "import React, { useEffect, useState } from 'react';\nimport TableWrapper from '../TableWrapper';\nimport { getColumns } from './TableColumns';\nimport { APPModules } from '@mi/constants/AppEnums';\nimport { GSTR3BAccess } from '@mi/permissions/returns/GSTR3B';\nimport type {\n  ThreeBCommonProps,\n  ThreeBDetailsProps,\n  ThreeBItemProps,\n} from '@mi/models/GstReturns/3B';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { getDataApi, postDataApi } from '@mi/hooks/APIHooks';\nimport AppTable from '@mi/shared/AppTable';\nimport {\n  onMPGSTR3bPrepareAutofil31,\n  onMPGSTR3bPrepareAutofilfrmSales,\n} from '@mi/services/mixpanel';\n\ntype Props = {\n  data: ThreeBItemProps[];\n  isLock: boolean;\n  updateData: (data: ThreeBItemProps[]) => void;\n  loading: boolean;\n  getCommonData: () => ThreeBCommonProps;\n};\n\nconst OutwardInwardSupplies = ({\n  data,\n  isLock,\n  updateData,\n  loading,\n  getCommonData,\n}: Props) => {\n  const [tableData, setTableData] = useState(data);\n\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const infoViewContext = useInfoViewActionsContext();\n  const [loader, setLoader] = useState(false);\n\n  useEffect(() => {\n    setTableData(data);\n  }, [data]);\n\n  const updateRecord = (record: ThreeBItemProps) => {\n    setTableData(\n      tableData.map((data) =>\n        data['nature_of_supplies'] === record['nature_of_supplies']\n          ? record\n          : data,\n      ),\n    );\n  };\n\n  const onEditEnabled = (status: boolean) => {\n    if (!status) {\n      setTableData(data);\n    }\n    setEditEnabled(status);\n  };\n  const onRefresh = () => {\n    setLoader(true);\n    getDataApi<ThreeBDetailsProps>(\n      'gst-returns/3b/refresh-table-three-one/',\n      infoViewContext,\n      {},\n    )\n      .then(({ data }) => {\n        onMPGSTR3bPrepareAutofilfrmSales();\n        onMPGSTR3bPrepareAutofil31();\n        updateData(data?.sup_details || []);\n        setLoader(false);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n        setLoader(false);\n      });\n  };\n\n  const onSaved = () => {\n    setLoader(true);\n    postDataApi('gst-returns/3b/edit-table-three-one/', infoViewContext, {\n      ...getCommonData(),\n      sup_details: tableData,\n    })\n      .then((data) => {\n        infoViewContext.showMessage(data.message);\n        setEditEnabled(false);\n        updateData(tableData);\n        setLoader(false);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n        setLoader(false);\n      });\n  };\n\n  return (\n    <TableWrapper\n      id='outward-inward-charge'\n      module={APPModules.GSTR3B}\n      access={GSTR3BAccess.AutofillSalesPurchaseRegister}\n      title='3.1 Details of Outward Supplies and Inward Supplies liable to Reverse Charge'\n      toolTipMessage='Autofill using Sales register'\n      autoFill={true}\n      hideEdit={isLock}\n      hideAutoRefresh={isLock}\n      onSaved={onSaved}\n      onRefresh={onRefresh}\n      onEditEnabled={onEditEnabled}\n      isEditEnabled={isEditEnabled}\n      /* actions={\n        <Button type='primary'>Autofill using Sales & Purchase register</Button>\n      }*/\n    >\n      <AppTable\n        loading={loading || loader}\n        columns={getColumns(isEditEnabled, updateRecord)}\n        dataSource={tableData}\n        size='small'\n        bordered\n        pagination={false}\n      />\n    </TableWrapper>\n  );\n};\n\nexport default OutwardInwardSupplies;\n"
      },
