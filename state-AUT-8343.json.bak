            "content": "import React from 'react';\nimport { AppAmountView } from '@mi/components/helperComponents';\nimport { getAmountColumn, onSortOrder } from '@mi/helpers/TableHelper';\nimport type { ColumnsType } from '@mi/models/MiTable';\nimport type { ThreeBItemProps } from '@mi/models/GstReturns/3B';\nimport { StyledInputNumber } from '../TableWrapper.styled';\nimport Table31dAutofill from './Table31dAutofill';\n\ntype AutofillProps = {\n  isLock: boolean;\n  autofillSource: string | null;\n  autofillLoading: boolean;\n  onAutofill: (source: string) => void;\n  onClear: () => void;\n};\n\nexport const getColumns = (\n  isEditEnabled: boolean,\n  updateRecord: (record: ThreeBItemProps) => void,\n  autofillProps?: AutofillProps,\n): ColumnsType<ThreeBItemProps> => [\n  {\n    title: 'Nature of Supplies',\n    dataIndex: 'nature_of_supplies',\n    render: (value: string, record: ThreeBItemProps) => {\n      if (record.nature_of_supplies?.startsWith('(d)') && autofillProps) {\n        return (\n          <div>\n            <div>{value}</div>\n            <Table31dAutofill\n              record={record}\n              isLock={autofillProps.isLock}\n              autofillSource={autofillProps.autofillSource}\n              autofillLoading={autofillProps.autofillLoading}\n              onAutofill={autofillProps.onAutofill}\n              onClear={autofillProps.onClear}\n            />\n          </div>\n        );\n      }\n      return value;\n    },\n  },\n  {\n    title: 'Total Taxable Value',\n    dataIndex: 'txval',\n    key: 'txval',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'txval'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            defaultValue={value}\n            onBlur={(e) => {\n              const data = { ...record };\n              data['txval'] = parseFloat(e.target.value) || 0;\n              updateRecord(data);\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n  {\n    title: 'IGST',\n    dataIndex: 'igst',\n    key: 'igst',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'igst'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            defaultValue={value}\n            onBlur={(e) => {\n              const data = { ...record };\n              data['igst'] = parseFloat(e.target.value) || 0;\n              updateRecord(data);\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n  {\n    title: 'CGST',\n    dataIndex: 'cgst',\n    key: 'cgst',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'cgst'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            value={value}\n            onChange={(value) => {\n              const data = { ...record };\n              data['cgst'] = parseFloat(value as string) || 0;\n              updateRecord({ ...data, sgst: data['cgst'] });\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n  {\n    title: 'SGST/UTGST',\n    dataIndex: 'sgst',\n    key: 'sgst',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'sgst'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            value={value}\n            onChange={(value) => {\n              const data = { ...record };\n              data['sgst'] = parseFloat(value as string) || 0;\n              updateRecord({ ...data, cgst: data['sgst'] });\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n  {\n    title: 'CESS',\n    dataIndex: 'cess',\n    key: 'cess',\n    ...getAmountColumn(),\n    sorter: (a, b) => onSortOrder(a, b, 'cess'),\n    render: (value, record) => {\n      if (value === 'blank') {\n        return '';\n      }\n\n      if (isEditEnabled) {\n        return (\n          <StyledInputNumber\n            type='number'\n            min={0}\n            step={0.01}\n            precision={2}\n            defaultValue={value}\n            onBlur={(e) => {\n              const data = { ...record };\n              data['cess'] = parseFloat(e.target.value) || 0;\n              updateRecord(data);\n            }}\n          />\n        );\n      } else {\n        return value === '' ? (\n          ''\n        ) : (\n          <AppAmountView amount={parseFloat(value).toFixed(2)} />\n        );\n      }\n    },\n  },\n];\n"
