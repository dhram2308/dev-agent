            "action": "update",
            "file_path": "libs/smb/src/lib/gst/3B/Details/OutwardInwardSupplies/index.tsx",
            "content": "import React, { useEffect, useState } from 'react';\nimport TableWrapper from '../TableWrapper';\nimport { getColumns } from './TableColumns';\nimport { APPModules } from '@mi/constants/AppEnums';\nimport { GSTR3BAccess } from '@mi/permissions/returns/GSTR3B';\nimport { IsPermissionAllowed } from '@mi/helpers/PermissionHelper';\nimport type {\n  ThreeBCommonProps,\n  ThreeBDetailsProps,\n  ThreeBItemProps,\n} from '@mi/models/GstReturns/3B';\nimport { useInfoViewActionsContext } from '@mi/context/AppInfoViewContextProvider';\nimport { getDataApi, postDataApi } from '@mi/hooks/APIHooks';\nimport AppTable from '@mi/shared/AppTable';\nimport {\n  onMPGSTR3bPrepareAutofil31,\n  onMPGSTR3bPrepareAutofilfrmSales,\n  onMPGSTR3bAutofill31dFromPurchase,\n  onMPGSTR3bAutofill31dFrom2BReco,\n  onMPGSTR3bAutofill31dClear,\n} from '@mi/services/mixpanel';\n\ntype Props = {\n  data: ThreeBItemProps[];\n  isLock: boolean;\n  updateData: (data: ThreeBItemProps[]) => void;\n  loading: boolean;\n  getCommonData: () => ThreeBCommonProps;\n};\n\nconst OutwardInwardSupplies = ({\n  data,\n  isLock,\n  updateData,\n  loading,\n  getCommonData,\n}: Props) => {\n  const [tableData, setTableData] = useState(data);\n\n  const [isEditEnabled, setEditEnabled] = useState(false);\n  const infoViewContext = useInfoViewActionsContext();\n  const [loader, setLoader] = useState(false);\n  const [autofillSource, setAutofillSource] = useState<string | null>(null);\n  const [autofillLoading, setAutofillLoading] = useState(false);\n\n  useEffect(() => {\n    setTableData(data);\n  }, [data]);\n\n  const updateRecord = (record: ThreeBItemProps) => {\n    setTableData(\n      tableData.map((data) =>\n        data['nature_of_supplies'] === record['nature_of_supplies']\n          ? record\n          : data,\n      ),\n    );\n  };\n\n  const onEditEnabled = (status: boolean) => {\n    if (!status) {\n      setTableData(data);\n    }\n    setEditEnabled(status);\n  };\n  const onRefresh = () => {\n    setLoader(true);\n    getDataApi<ThreeBDetailsProps>(\n      'gst-returns/3b/refresh-table-three-one/',\n      infoViewContext,\n      {},\n    )\n      .then(({ data }) => {\n        onMPGSTR3bPrepareAutofilfrmSales();\n        onMPGSTR3bPrepareAutofil31();\n        updateData(data?.sup_details || []);\n        setAutofillSource(null);\n        setLoader(false);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n        setLoader(false);\n      });\n  };\n\n  const onSaved = () => {\n    setLoader(true);\n    postDataApi('gst-returns/3b/edit-table-three-one/', infoViewContext, {\n      ...getCommonData(),\n      sup_details: tableData,\n    })\n      .then((data) => {\n        infoViewContext.showMessage(data.message);\n        setEditEnabled(false);\n        updateData(tableData);\n        setLoader(false);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n        setLoader(false);\n      });\n  };\n\n  const on31dAutofill = (source: string) => {\n    setAutofillLoading(true);\n    postDataApi<{ sup_details: ThreeBItemProps[] }>(\n      'gst-returns/3b/fill-from-2b-pr-reco/',\n      infoViewContext,\n      { fill_table: '31d', source },\n    )\n      .then(({ data, message }) => {\n        const row31d = data?.sup_details?.find((item) =>\n          item.nature_of_supplies?.startsWith('(d)'),\n        );\n        if (row31d) {\n          updateRecord(row31d);\n          setAutofillSource(source);\n          if (source === 'purchase_register') {\n            onMPGSTR3bAutofill31dFromPurchase();\n          } else {\n            onMPGSTR3bAutofill31dFrom2BReco();\n          }\n          if (message) {\n            infoViewContext.showMessage(message);\n          }\n        } else {\n          infoViewContext.showMessage(\n            message ||\n              (source === '2b_pr_reco'\n                ? 'No accepted RCM invoices found in 2B vs PR reco for this period'\n                : 'No RCM invoices found in Purchase register for this period'),\n          );\n        }\n        setAutofillLoading(false);\n      })\n      .catch((error) => {\n        infoViewContext.fetchError(error.message);\n        setAutofillLoading(false);\n      });\n  };\n\n  const on31dClear = () => {\n    const updatedData = tableData.map((item) => {\n      if (item.nature_of_supplies?.startsWith('(d)')) {\n        return { ...item, txval: 0, igst: 0, cgst: 0, sgst: 0, cess: 0 };\n      }\n      return item;\n    });\n    setTableData(updatedData);\n    setAutofillSource(null);\n    onMPGSTR3bAutofill31dClear();\n  };\n\n  return (\n    <TableWrapper\n      id='outward-inward-charge'\n      module={APPModules.GSTR3B}\n      access={GSTR3BAccess.AutofillSalesPurchaseRegister}\n      title='3.1 Details of Outward Supplies and Inward Supplies liable to Reverse Charge'\n      toolTipMessage='Autofill using Sales register'\n      autoFill={true}\n      hideEdit={isLock}\n      hideAutoRefresh={isLock}\n      onSaved={onSaved}\n      onRefresh={onRefresh}\n      onEditEnabled={onEditEnabled}\n      isEditEnabled={isEditEnabled}\n      /* actions={\n        <Button type='primary'>Autofill using Sales & Purchase register</Button>\n      }*/\n    >\n      <AppTable\n        loading={loading || loader}\n        columns={getColumns(isEditEnabled, updateRecord, {\n          isLock,\n          autofillSource,\n          autofillLoading,\n          onAutofill: on31dAutofill,\n          onClear: on31dClear,\n        })}\n        dataSource={tableData}\n        size='small'\n        bordered\n        pagination={false}\n      />\n    </TableWrapper>\n  );\n};\n\nexport default OutwardInwardSupplies;\n"
          },
          {
            "action": "create",
            "file_path": "libs/smb/src/lib/gst/3B/Details/OutwardInwardSupplies/Table31dAutofill.styles.ts",
            "content": "import styled from 'styled-components';\nimport { Select, Tag } from 'antd';\n\nexport const StyledAutofillWrapper = styled.div`\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-top: 6px;\n`;\n\nexport const StyledSourceChip = styled(Tag)`\n  margin: 0;\n  font-size: 12px;\n  border-radius: 4px;\n`;\n\nexport const StyledAutofillSelect = styled(Select)`\n  width: 200px;\n`;\n"
          },
          {
            "action": "create",
            "file_path": "libs/smb/src/lib/gst/3B/Details/OutwardInwardSupplies/Table31dAutofill.tsx",
            "content": "import React, { useState } from 'react';\nimport { Button, Modal } from 'antd';\nimport type { ThreeBItemProps } from '@mi/models/GstReturns/3B';\nimport {\n  StyledAutofillWrapper,\n  StyledAutofillSelect,\n  StyledSourceChip,\n} from './Table31dAutofill.styles';\n\nconst AUTOFILL_SOURCES = [\n  { value: 'purchase_register', label: 'Purchase register' },\n  { value: '2b_pr_reco', label: 'GSTR-2B vs Purchase Reco' },\n];\n\nconst SOURCE_CHIP_LABELS: Record<string, string> = {\n  purchase_register: 'Purchase register',\n  '2b_pr_reco': '2B vs PR reco',\n};\n\ntype Props = {\n  record: ThreeBItemProps;\n  isLock: boolean;\n  hasAutofillPermission: boolean;\n  autofillSource: string | null;\n  autofillLoading: boolean;\n  onAutofill: (source: string) => void;\n  onClear: () => void;\n};\n\nconst Table31dAutofill = ({\n  record,\n  isLock,\n  hasAutofillPermission,\n  autofillSource,\n  autofillLoading,\n  onAutofill,\n  onClear,\n}: Props) => {\n  const [selectedSource, setSelectedSource] = useState<string | undefined>(\n    undefined,\n  );\n\n  const hasExistingValues = () => {\n    const { txval, igst, cgst, sgst, cess } = record;\n    return [txval, igst, cgst, sgst, cess].some(\n      (v) =>\n        v !== undefined && v !== '' && v !== 0 && v !== '0' && v !== 'blank',\n    );\n  };\n\n  const onApply = () => {\n    if (!selectedSource) return;\n\n    if (hasExistingValues() && !autofillSource) {\n      Modal.confirm({\n        title: 'Overwrite existing values?',\n        content: '3.1(d) already has values. Do you want to replace them?',\n        okText: 'Replace',\n        cancelText: 'Cancel',\n        onOk: () => {\n          onAutofill(selectedSource);\n        },\n      });\n    } else {\n      onAutofill(selectedSource);\n    }\n  };\n\n  const onClearClick = () => {\n    setSelectedSource(undefined);\n    onClear();\n  };\n\n  if (isLock || !hasAutofillPermission) return null;\n\n  if (autofillSource) {\n    return (\n      <StyledAutofillWrapper>\n        <StyledSourceChip color='blue'>\n          {SOURCE_CHIP_LABELS[autofillSource]}\n        </StyledSourceChip>\n        <Button type='link' size='small' onClick={onClearClick}>\n          Clear\n        </Button>\n      </StyledAutofillWrapper>\n    );\n  }\n\n  return (\n    <StyledAutofillWrapper>\n      <StyledAutofillSelect\n        size='small'\n        placeholder='Select source'\n        value={selectedSource}\n        onChange={setSelectedSource}\n        options={AUTOFILL_SOURCES}\n      />\n      <Button\n        type='primary'\n        size='small'\n        onClick={onApply}\n        disabled={!selectedSource}\n        loading={autofillLoading}\n      >\n        Apply\n      </Button>\n    </StyledAutofillWrapper>\n  );\n};\n\nexport default Table31dAutofill;\n"
          }
        ],
        "summary": "Error: Reached max turns (25)",
        "test_notes": "See developer summary above"
      },
      "plan": "The 4 OpenSpec artifacts are complete. Here's a summary of what was produced:\n\n**Proposal** — Establishes that RCM liability in 3.1(d) is never auto-filled when users accept \"Not in Purchase Register\" invoices in reconciliation, creating compliance risk. Introduces one new capability: `table-31d-inline-autofill`.\n\n**Design** — 6 key decisions: inline control in the \"Nature of Supplies\" column cell (D1), encapsulated `Table31dAutofill` component (D2), reuse `fill-from-2b-pr-reco/` endpoint with RCM-only params (D3), local state in `OutwardInwardSupplies` (D4), Ant Design `Tag` for source chip (D5), `Modal.confirm` for overwrite dialog (D6).\n\n**Specs** — 11 requirements with 19 WHEN/THEN scenarios covering: inline control rendering, dropdown options, 2B-vs-PR-reco autofill, purchase-register autofill, source chip display, Clear reset, empty result handling, overwrite confirmation, API error handling, permission gating, global refresh interaction, and Mixpanel tracking.\n\n**Tasks** — 8 task groups with 24 checkboxed tasks ordered by dependency: types/constants → mixpanel events → styled components → core `Table31dAutofill` component → `OutwardInwardSupplies` state/API logic → `TableColumns` conditional render → tests → verification.",
