# ── MI Dev Agent — Environment Variables ─────────────────────
# Copy this file to .env and fill in the values.

# ── Jira ──────────────────────────────────────────────────────
# JIRA_TOKEN=
# JIRA_EMAIL=
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_COMMENTS_ENABLED=true
# OWNER_JIRA_ID=
# QA_JIRA_ID=

# ── GitLab ────────────────────────────────────────────────────
# GITLAB_TOKEN=
# GITLAB_PROJECT_ID=
# GITLAB_URL=http://your-gitlab-host
# GITLAB_CLONE_URL=git@your-gitlab-host:org/repo.git
# GITLAB_ASSIGNEE_ID=
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_CLONE_DEPTH=50
# MAX_COMMIT_FILE_SIZE=512000

# ── Slack ─────────────────────────────────────────────────────
# OWNER_SLACK_ID=
# QA_SLACK_ID=
# SLACK_WEBHOOK=

# ── Claude Code Generation Timeouts (ms) ─────────────────────
# CODEGEN_TIMEOUT=420000
# CLAUDE_TIMEOUT=180000
# CLAUDE_MODEL=
# ANALYSIS_TIMEOUT=600000
# DEVELOPER_TIMEOUT=900000
# REVIEWER_TIMEOUT=600000
# TEST_FIXER_TIMEOUT=180000

# ── Approval / Pipeline Timeouts (ms) ────────────────────────
# MAX_APPROVAL_TIMEOUT=28800000
# MAX_PIPELINE_DURATION=86400000
# MAX_CONTINUE_WAIT=7200000
# MERGE_POLL_TIMEOUT=1800000
# URL_FETCH_TIMEOUT=120000
# APPROVAL_REMINDER_1H=3600000
# APPROVAL_REMINDER_4H=14400000
# ALLOW_ANY_APPROVER=false
# MAX_REJECTIONS=3
# MAX_PLAN_REJECTIONS=5

# ── Limits ────────────────────────────────────────────────────
# MAX_PROMPT_TOKENS=180000
# FETCH_CONCURRENCY=5
# MAX_FREE_SOCKETS=10
# MAX_CONCURRENT_AGENTS=3
# MAX_TOTAL_COMMENTS=100
# MAX_TOTAL_ATTACHMENTS=20
# MAX_TOTAL_URL_CONTENT=500000
# MAX_STATE_SIZE=10000000

# ── QA ────────────────────────────────────────────────────────
# QA_URL=https://qa-enterprise.example.com
# QA1_URL=https://qa1-enterprise.example.com
# QA_SMOKE_LEVEL=basic
# SKIP_SMOKE_CHECK=false
# QA_HEALTH_TIMEOUT=10000

# ── Build & Test ──────────────────────────────────────────────
# RUN_BUILD_CHECK=true
# BUILD_INSTALL_TIMEOUT=180000
# BUILD_TSC_TIMEOUT=120000
# BUILD_ESLINT_TIMEOUT=60000
# RUN_RUNTIME_TESTS=true
# UNIT_TESTS_TIMEOUT=180000
# E2E_TESTS_TIMEOUT=300000
# MAX_UNIT_TEST_RETRIES=2
# MAX_E2E_TEST_RETRIES=3
# VITE_PREVIEW_TIMEOUT=30000
# VITE_BUILD_TIMEOUT=600000
# CONSOLE_WARNING_THRESHOLD=5
# TEST_ARTIFACTS_DIR=.test-artifacts
# PLAYWRIGHT_BROWSER=chromium

# ── Browser Verification ─────────────────────────────────────
# BROWSER_VERIFY=true
# MAX_VERIFY_RETRIES=3
# NX_SERVE_TIMEOUT=120000
# NX_SERVE_PORT_RANGE_START=4200
# NX_SERVE_PORT_RANGE_END=4299
# VERIFICATION_TIMEOUT=300000
# EVIDENCE_MAX_SIZE=10240
# VITE_PREVIEW_PORT_START=4300
# VITE_PREVIEW_PORT_END=4399

# ── Server / Logging ─────────────────────────────────────────
# LOG_LEVEL=info
# LOG_FORMAT=text
# SAVE_DEBUG_OUTPUT=false
# PORT=3000
# BIND_HOST=127.0.0.1
# ALLOW_STAGE_SKIP=false

# ── Vite App ──────────────────────────────────────────────────
# VITE_APP_API_URL=
# VITE_APP_QA=
# VITE_PRODUCT_ID=2

# ── CI Polling ────────────────────────────────────────────────
# POLL_INTERVAL=30000
# CI_POLL=60000
# CI_TIMEOUT=1800000

# ── OAuth Connectors ──────────────────────────────────────────
# Feature flags (default: off for safe rollout)
# ENABLE_CREDENTIAL_STORE=false
# ENABLE_OAUTH=false

# Google Drive OAuth (Desktop client, drive.file scope)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# Figma OAuth (S256 PKCE, client secret required)
# OAUTH_FIGMA_CLIENT_ID=
# OAUTH_FIGMA_CLIENT_SECRET=

# GitLab OAuth (PKCE, client secret optional for public clients)
# OAUTH_GITLAB_CLIENT_ID=
# OAUTH_GITLAB_CLIENT_SECRET=
# GITLAB_AUTH_MODE=pat

# Credential store encryption key (used by encrypted-file backend)
# CRED_ENC_KEY=

# Pre-loaded OAuth tokens for CI/Docker (base64 JSON, read-only)
# MI_DEV_AGENT_OAUTH_TOKENS=

# Auth timeout in minutes for paused pipelines (default: 120)
# AUTH_TIMEOUT_MIN=120

# HTTP bind host (default: 127.0.0.1 for loopback-only OAuth)
# HTTP_BIND_HOST=127.0.0.1
